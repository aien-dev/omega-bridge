18446744073709551615:\n            raise ValueError(\"omega scalar: an int in 0 .. 2**64-1 expected, got %r\" % (v,))\n        return ctypes.c_uint64(v)\n_res = ctypes.POINTER(ctypes.c_uint64)\n_a3 = ctypes.POINTER(ctypes.c_uint64)  # edit ulong: a writable ctypes array of c_uint64\n_a4 = ctypes.POINTER(ctypes.c_uint64)  # view ulong: a ctypes array of c_uint64\n_a5 = ctypes.POINTER(ctypes.c_ubyte)  # edit uchar: a writable ctypes array of c_ubyte\n_a6 = ctypes.c_char_p  # view uchar: bytes, or a ctypes array of c_char\n~# ~\nomega_~ = lib.omega_~\nomega_~.argtypes = [_res~, _u64~, _a~]\nomega_~.restype = ctypes.c_uint32\n~// Generated by omega-bridge src/native.om: native call ABI v1 (docs/NATIVE-ABI.md).\n// Declarations for libomega_native (build with -L <its directory>; Rust 1.82 or later). Regenerate it; do not edit it.\n// Status: 0 done; 1..14 the Omega trap code; 32 argument refused (null, wrong length, misaligned,\n// overlap); 33 reentry; 34 bad runtime entry; 35 no stack. The result is written only on status 0.\n// A long is its two's-complement bits (an i64 as u64); an array is its pointer then its element count.\n#[allow(dead_code)]\npub const OMEGA_OK: u32 = 0;\n#[allow(dead_code)]\npub const OMEGA_BAD_ARG: u32 = 32;\n#[allow(dead_code)]\npub const OMEGA_REENTRY: u32 = 33;\n#[allow(dead_code)]\npub const OMEGA_BAD_RT: u32 = 34;\n#[allow(dead_code)]\npub const OMEGA_NO_STACK: u32 = 35;\n#[allow(dead_code)]\n#[link(name = \"omega_native\")]\nunsafe extern \"C\" {\n~    // ~\n    pub fn omega_~(result: *mut u64~, o_~: u64~: *mut u64~: *const u64~: *mut u8~: *const u8~_len: u64~) -> u32;\n~}\n~// Generated by omega-bridge src/native.om: native call ABI v1 (docs/NATIVE-ABI.md).\n// Declarations for libomega_native (build with -L<its directory> -lomega_native -lc). Regenerate it; do not edit it.\n// Status: 0 done; 1..14 the Omega trap code; 32 argument refused (null, wrong length, misaligned,\n// overlap); 33 reentry; 34 bad runtime entry; 35 no stack. The result is written only on status 0.\n// A long is its two's-complement bits (@bitCast); an array is its pointer then its element count.\npub const OMEGA_OK: u32 = 0;\npub const OMEGA_BAD_ARG: u32 = 32;\npub const OMEGA_REENTRY: u32 = 33;\npub const OMEGA_BAD_RT: u32 = 34;\npub const OMEGA_NO_STACK: u32 = 35;\n~// ~\npub extern fn omega_~(result: ?*u64~, o_~: u64~: ?[*]u64~: ?[*]const u64~: ?[*]u8~: ?[*]const u8~_len: u64~) u32;\n~// Generated by omega-bridge src/native.om: native call ABI v1 (docs/NATIVE-ABI.md).\n// cgo package omeganative: this file, omega_native.h and libomega_native.so in one folder. Regenerate it;\n// do not edit it. No run-time path is baked in: the program's build names the folder (CGO_LDFLAGS set to\n// -Wl,-rpath,<folder>), or LD_LIBRARY_PATH does.\n// Status: 0 done; 1..14 the Omega trap code; 32 argument refused (nil, wrong length, misaligned,\n// overlap); 33 reentry; 34 bad runtime entry; 35 no stack. The result is written only on status 0.\n// A long is its two's-complement bits (an int64 as uint64); an array is an unsafe.Pointer to memory\n// holding no Go pointers, then its element count.\npackage omeganative\n\n/*\n#cgo CFLAGS: -I${SRCDIR}\n#cgo LDFLAGS: -L${SRCDIR} -lomega_native\n#include \"omega_native.h\"\n*/\nimport \"C\"\n\nimport \"unsafe\"\n\nconst (\n\tOmegaOK uint32 = 0\n\tOmegaBadArg uint32 = 32\n\tOmegaReentry uint32 = 33\n\tOmegaBadRt uint32 = 34\n\tOmegaNoStack uint32 = 35\n)\n~\n// ~\nfunc Omega_~(result *uint64~, o_~ uint64~ unsafe.Pointer~ unsafe.Pointer~ unsafe.Pointer~ unsafe.Pointer~_len uint64~) uint32 {\n\treturn uint32(C.omega_~((*C.uint64_t)(unsafe.Pointer(result))~, C.uint64_t(o_~)~, o_~_len)~))\n}\n"
note ob: append one byte to the output pool (trap 6 when it is full).
fn ob b uchar to void
n = get st 1
if ge n len outb
trap 6
end
put outb n b
put st 1 add n 1
end
note orng: copy input bytes s .. e-1 to the output.
fn orng s ulong e ulong to void
i = s
while lt i e
ob get inb i
i = add i 1
end
end
note odec: v in decimal.
fn odec v ulong to void
x = v
n = ulong 0
put dg n uchar add rem x 10 48
n = add n 1
x = div x 10
while ne x 0
put dg n uchar add rem x 10 48
n = add n 1
x = div x 10
end
while gt n 0
n = sub n 1
ob get dg n
end
end
note ohex: one byte as 0xNN.
fn ohex b uchar to void
ob uchar 48
ob uchar 120
ob get hx shr b 4
ob get hx and b 15
end
note opre: the fixed runtime part of the C file.
fn opre to void
for i ulong len pre
ob get pre i
end
end
note ofr: fragment k of fr (fragments are separated by ~, byte 126).
fn ofr k ulong to void
c = ulong 0
for i ulong len fr
b = get fr i
if eq b 126
c = add c 1
else
if eq c k
ob b
end
end
end
end
note ofb: fragment k of tb.
fn ofb k ulong to void
c = ulong 0
for i ulong len tb
b = get tb i
if eq b 126
c = add c 1
else
if eq c k
ob b
end
end
end
end
note mdis: 1 when the argument in md (its length in st 8) is mo[o .. o+n-1], else 0.
fn mdis o ulong n ulong to ulong
if ne get st 8 n
ret 0
end
for j ulong n
if ne get md j get mo add o j
ret 0
end
end
ret 1
end
note rmode: the one argument as an output number: 1 c, 2 h, 3 python, 4 rust, 5 zig, 6 go.
fn rmode to ulong
if ne argcnt 2
trap 10
end
k = argread 1 md 0 8
if lt k 0
trap 10
end
put st 8 ulong k
m = ulong 0
if eq mdis 0 1 1
m = 1
end
if eq mdis 1 1 1
m = 2
end
if eq mdis 2 6 1
m = 3
end
if eq mdis 8 4 1
m = 4
end
if eq mdis 12 3 1
m = 5
end
if eq mdis 15 2 1
m = 6
end
if eq mdis 17 3 1
m = 7
end
if eq mdis 17 4 1
m = 8
end
if eq mdis 21 4 1
m = 9
end
if eq m 0
trap 10
end
ret m
end
note tkis: 1 when token k is the keyword kw[o .. o+n-1], else 0.
fn tkis k ulong o ulong n ulong to ulong
s = get tks k
e = get tke k
if ne sub e s n
ret 0
end
for j ulong n
if ne get inb add s j get kw add o j
ret 0
end
end
ret 1
end
note tknum: token k as a decimal number of 1 .. 8 digits.
fn tknum k ulong to ulong
s = get tks k
e = get tke k
if or eq s e gt sub e s 8
trap 10
end
v = ulong 0
for j ulong sub e s
c = get inb add s j
if or lt c 48 gt c 57
trap 10
end
v = add mul v 10 ulong sub c 48
end
ret v
end
note tokln: split the line that starts at p (ending at a newline or at q) into tokens at spaces.
fn tokln p ulong q ulong to ulong
e = p
while and lt e q ne get inb e 10
e = add e 1
end
put st 7 e
n = ulong 0
s = p
i = p
while lt i e
if eq get inb i 32
if gt i s
put tks n s
put tke n i
n = add n 1
end
s = add i 1
end
i = add i 1
end
if gt e s
put tks n s
put tke n e
n = add n 1
end
ret n
end
note oname: the name of token k.
fn oname k ulong to void
orng get tks k get tke k
end
note opn: the name of parameter j.
fn opn j ulong to void
orng get ps j get pe j
end
note osig: the unit's signature line (st 6 .. st 7), the comment each binding carries.
fn osig to void
orng get st 6 get st 7
end
note sepat: where the 0 byte after the source starting at p is.
fn sepat p ulong to ulong
t = get st 0
q = p
while and lt q t ne get inb q 0
q = add q 1
end
if ge q t
trap 10
end
ret q
end
note isfn: 1 when the bytes at i are "fn ".
fn isfn i ulong to ulong
if ne get inb i 102
ret 0
end
if ne get inb add i 1 110
ret 0
end
if ne get inb add i 2 32
ret 0
end
ret 1
end
note sigln: the start of the last line in p .. q-1 that begins with "fn " (the compiler's entry).
fn sigln p ulong q ulong to ulong
fl = ulong 0
nf = ulong 0
ls = p
i = p
while lt i q
if eq i ls
if eq isfn i 1
fl = i
nf = add nf 1
end
end
if eq get inb i 10
ls = add i 1
end
i = add i 1
end
if eq nf 0
trap 10
end
ret fl
end
note pkind: the kind of the parameter whose type starts at token ty: 1 ulong, 2 long, 3 edit ulong,
note 4 view ulong, 5 edit uchar, 6 view uchar; 0 when refused.
fn pkind ty ulong nt ulong to ulong
if eq tkis ty 10 5 1
ret 1
end
if eq tkis ty 15 4 1
ret 2
end
w = ulong 0
if eq tkis ty 6 4 1
w = 1
else
if ne tkis ty 2 4 1
ret 0
end
end
if ge add ty 2 nt
ret 0
end
el = add ty 1
if eq tkis el 10 5 1
ret add 3 w
end
if eq tkis el 19 5 1
ret add 5 w
end
ret 0
end
note cidr: 1 when bytes s .. e-1 form a C identifier ([A-Za-z_][A-Za-z0-9_]*), else 0.
fn cidr s ulong e ulong to ulong
if ge s e
ret 0
end
for j ulong sub e s
c = get inb add s j
ok = ulong 0
if eq c 95
ok = 1
end
if and ge c 97 le c 122
ok = 1
end
if and ge c 65 le c 90
ok = 1
end
if and gt j 0 and ge c 48 le c 57
ok = 1
end
if eq ok 0
ret 0
end
end
ret 1
end
note lensuf: 1 when bytes s .. e-1 end in "_len" (the binding names an array length o_<name>_len).
fn lensuf s ulong e ulong to ulong
if lt sub e s 4
ret 0
end
b = sub e 4
if ne get inb b 95
ret 0
end
if ne get inb add b 1 108
ret 0
end
if ne get inb add b 2 101
ret 0
end
if ne get inb add b 3 110
ret 0
end
ret 1
end
note pname: refuse a parameter name that is not a C identifier or ends in "_len".
fn pname s ulong e ulong to void
if eq cidr s e 0
trap 10
end
if eq lensuf s e 1
trap 10
end
end
note samenm: 1 when bytes a .. b-1 equal bytes c .. d-1.
fn samenm a ulong b ulong c ulong d ulong to ulong
if ne sub b a sub d c
ret 0
end
for j ulong sub b a
if ne get inb add a j get inb add c j
ret 0
end
end
ret 1
end
note uname: refuse a unit name (token 1) that is not a C identifier or repeats an earlier unit name.
fn uname to void
s = get tks 1
e = get tke 1
if eq cidr s e 0
trap 10
end
n = get st 4
if ge n 256
trap 10
end
for j ulong n
if eq samenm s e get us j get ue j 1
trap 10
end
end
put us n s
put ue n e
put st 4 add n 1
end
note pparam: record the parameter at token k in slot st 2; return the token after it.
fn pparam k ulong nt ulong to ulong
np = get st 2
if ge np 6
trap 10
end
put ps np get tks k
put pe np get tke k
ki = pkind add k 1 nt
if eq ki 0
trap 10
end
put pk np ki
pname get tks k get tke k
put st 2 add np 1
if le ki 2
ret add k 2
end
ln = tknum add k 3
if or eq ln 0 gt ln 16777216
trap 10
end
put pl np ln
ret add k 4
end
note parse: read the signature line at fl; parameters into ps pe pk pl, their count into st 2,
note 1 or 0 into st 3 for a function with or without a value.
fn parse fl ulong q ulong to void
put st 6 fl
nt = tokln fl q
if lt nt 4
trap 10
end
if eq tkis 1 28 4 1
trap 10
end
uname
put st 2 0
k = ulong 2
while eq tkis k 0 2 0
if ge add k 1 nt
trap 10
end
k = pparam k nt
if ge k nt
trap 10
end
end
if ne add k 2 nt
trap 10
end
r = add k 1
hv = ulong 2
if or eq tkis r 10 5 1 eq tkis r 15 4 1
hv = 1
end
if eq tkis r 24 4 1
hv = 0
end
if eq hv 2
trap 10
end
put st 3 hv
end
note codelen: the 8-digit code length after the 0 byte at q, checked against the input.
fn codelen q ulong to ulong
t = get st 0
c0 = add q 9
if gt c0 t
trap 10
end
cl = ulong 0
for j ulong 8
d = get inb add add q 1 j
if or lt d 48 gt d 57
trap 10
end
cl = add mul cl 10 ulong sub d 48
end
if or eq cl 0 ne rem cl 4 0
trap 10
end
if gt cl sub t c0
trap 10
end
ret cl
end
note ecode: the embedded machine code, unchanged.
fn ecode c0 ulong cl ulong to void
ofr 0
oname 1
ofr 1
oname 1
ofr 2
oname 1
ofr 3
for j ulong cl
if gt j 0
ob uchar 44
end
ohex get inb add c0 j
end
ofr 24
oname 1
ofr 25
oname 1
ofr 26
oname 1
ofr 27
oname 1
ofr 4
oname 1
ofr 5
oname 1
end
note esig: the exported C parameter list.
fn esig to void
ofr 6
for j ulong get st 2
x = get pk j
if le x 2
ofr 7
opn j
else
if or eq x 3 eq x 5
ofr 8
else
ofr 9
end
opn j
ofr 7
opn j
ofr 10
end
end
end
note earr: the checks and argument word for array parameter j of kind x.
fn earr j ulong x ulong to void
ofr 12
opn j
ofr 13
opn j
ofr 14
odec get pl j
ofr 15
if le x 4
odec 8
else
odec 1
end
ofr 15
if or eq x 3 eq x 5
odec 1
else
odec 0
end
ofr 16
odec j
ofr 17
opn j
ofr 18
end
note ebody: argument words, overlap check and the call.
fn ebody to void
ofr 11
for j ulong get st 2
x = get pk j
if le x 2
ofr 19
odec j
ofr 20
opn j
ofr 18
else
earr j x
end
end
ofr 21
oname 1
ofr 22
odec get st 3
ofr 23
end
note edeclC: a declaration with the type before the name (h): the comment
note fragments at cb (open, close + head) and the type fragments at tb (result, scalar, the four
note array kinds, the length suffix, close).
fn edeclC cb ulong tp ulong to void
ofb cb
osig
ofb add cb 1
oname 1
ofb tp
for j ulong get st 2
x = get pk j
if le x 2
ofb add tp 1
opn j
else
ofb add tp sub x 1
opn j
ofb add tp 1
opn j
ofb add tp 6
end
end
ofb add tp 7
end
note edeclR: a declaration with the name before the type (rust, zig, the go wrapper head): the
note type fragments at tp are result, the name prefix, scalar, the four array kinds, length, close.
fn edeclR cb ulong tp ulong to void
ofb cb
osig
ofb add cb 1
oname 1
ofb tp
for j ulong get st 2
x = get pk j
ofb add tp 1
opn j
if le x 2
ofb add tp 2
else
ofb add tp x
ofb add tp 1
opn j
ofb add tp 7
end
end
ofb add tp 8
end
note epy: the python declaration: the function, its argument types, its result type.
fn epy to void
ofb 13
osig
ofb 14
oname 1
ofb 15
oname 1
ofb 16
oname 1
ofb 17
for j ulong get st 2
if le get pk j 2
ofb 18
else
ofb 19
odec get pk j
ofb 18
end
end
ofb 20
oname 1
ofb 21
end
note ecall: the go wrapper's call of the C function and its end.
fn ecall to void
oname 1
ofb 59
for j ulong get st 2
if le get pk j 2
ofb 60
opn j
ofb 61
else
ofb 62
opn j
ofb 60
opn j
ofb 63
end
end
ofb 64
end
note emit: the parsed unit in the output named by st 5.
fn emit c0 ulong cl ulong to void
m = get st 5
if eq m 1
ecode c0 cl
esig
ebody
end
if eq m 2
edeclC 1 3
end
if eq m 3
epy
end
if eq m 4
edeclR 23 25
end
if eq m 5
edeclR 36 38
end
if eq m 6
edeclR 48 50
ecall
end
end
note ======== ABI v2: OM-2 units (docs/NATIVE-ABI.md, ABI v2) ========
note An OM-2 unit (its first line that is not a note is exactly om2) is bound as omega2_<name>, one symbol
note per `export fn` (in source order; without any export, the last fn as in v1), and carries its
note identity. Its frame is the v1 frame followed by the line `omega-unit NAME OMC`, NAME the unit's C
note name and OMC the sha256 of the compiler that wrote the code (64 hex digits), both supplied by
note tools/native. The source sha256 is computed here from the unit's exact bytes. A parameter is a
note ulong or long scalar (one slot), a sized array `view|edit T N` (one slot), an unsized view
note `view|edit T *` (two slots: pointer, element count), a layout `view|edit L` (one slot) or
note `out T N` (one slot), T any of uchar ushort uint ulong byte short int long; at most 6 slots; the
note result is ulong, long or void. s2: 0 the C prelude written, 1 2 the unit name, 3 the omc digest,
note 4 the export count, 5 slots used, 6 7 the source, 8 has a value, 9 out bytes, 10 layouts,
note 11 unit names, 12 the entry index, 13 14 the code, 16 17 the bound name, 18 the result type.
note q*: per parameter class (1 scalar, 2 sized array, 3 unsized view, 4 layout, 5 out), mode (0 view,
note 1 edit), element type, count (or layout size), first slot, layout index.
global s2 ulong 32
global qk ulong 6
global qm ulong 6
global qt ulong 6
global qn ulong 6
global qs ulong 6
global ql ulong 6
global lys ulong 32
global lye ulong 32
global lyz ulong 32
global lyl ulong 32
global lcs ulong 32
global lce ulong 32
global uns ulong 256
global une ulong 256
global exl ulong 32
global fds ulong 256
global fde ulong 256
global fdt ulong 256
global fdc ulong 256
global fdo ulong 256
global fdb ulong 256
global fdu ulong 256
global shk ulong 72
global shw ulong 64
global shh ulong 8
global shv ulong 8
global shb uchar 64
note kv: the OM-2 words: export 0, fn 6, out 8, om2 11, ushort 14, uint 20, byte 24, short 28, int 33,
note layout 36, field 42, end 47, note 50, bridge 54, c-type 60, c-define 66, little 74, big 80, * 83,
note at 84, omega-unit 86.
text kv "exportfnoutom2ushortuintbyteshortintlayoutfieldendnotebridgec-typec-definelittlebig*atomega-unit"
note fv: the v2 output fragments, separated by ~ (byte 126): 0 the C prelude, 1-10 the code and the
note identity, 11-13 the identity text, 14-20 an entry stub, 21-24 the C function head, 25-30 a C
note parameter, 31-50 the C body, 51-56 h, 57-75 and 155 python, 76-88 rust, 89-98 zig, 99-117 go,
note 118-154 the api header. tn: the element type names, 8 per language: C, ctypes, rust and zig, cgo.
text fv "/* ABI v2 (docs/NATIVE-ABI.md, ABI v2): OM-2 units, bound as omega2_<export>. An unsized view is its\n * pointer and its element count; a layout is a pointer to its fixed bytes; an out parameter is written\n * to a buffer the binding owns and copied to the caller only after status 0. */\n#include <string.h>\ntypedef struct ombr2_out { unsigned slot; uint64_t n; void *dst; } ombr2_out;\n/* A library of OM-2 units alone calls neither of the ABI v1 helpers. */\n__attribute__((unused)) static void ombr2_keep(void)\n{\n    (void)ombr_overlap;\n    (void)ombr_run;\n}\n/* An unsized view of n elements of es bytes. n == 0 is the empty view whatever the pointer (it adds no\n * range, so it overlaps nothing). Otherwise refused: a null pointer, a pointer not aligned to es,\n * n * es over 64 bits, or an end past the top of the address space. */\n__attribute__((unused)) static int ombr2_view(ombr_span *sp, unsigned *ns, const void *p, uint64_t n, uint64_t es, int w)\n{\n    uintptr_t lo = (uintptr_t)p;\n    if (n == 0u)\n        return 0;\n    if (!p || lo % es != 0u || n > UINT64_MAX / es || n * es > UINTPTR_MAX - lo)\n        return 1;\n    sp[*ns].lo = lo;\n    sp[*ns].hi = lo + n * es;\n    sp[*ns].w = w;\n    (*ns)++;\n    return 0;\n}\n/* A fixed range of nb > 0 bytes (a layout or an out parameter) aligned to es. */\n__attribute__((unused)) static int ombr2_fixed(ombr_span *sp, unsigned *ns, const void *p, uint64_t nb, uint64_t es,\n                                               int w)\n{\n    uintptr_t lo = (uintptr_t)p;\n    if (!p || lo % es != 0u || nb > UINTPTR_MAX - lo)\n        return 1;\n    sp[*ns].lo = lo;\n    sp[*ns].hi = lo + nb;\n    sp[*ns].w = w;\n    (*ns)++;\n    return 0;\n}\n/* w: 0 view, 1 edit or the result, 2 out. Refused: an edit or the result overlapping any other range,\n * or two out ranges overlapping. An out may overlap a view: it is written only after the code returns. */\nstatic int ombr2_overlap(const ombr_span *sp, unsigned ns)\n{\n    for (unsigned i = 0; i < ns; i++)\n        for (unsigned j = i + 1; j < ns; j++)\n            if ((sp[i].w == 1 || sp[j].w == 1 || (sp[i].w == 2 && sp[j].w == 2))\n                && sp[i].lo < sp[j].hi && sp[j].lo < sp[i].hi)\n                return 1;\n    return 0;\n}\n/* As ombr_run, and each out buffer is carved from the top of the thread's Omega stack (16-byte aligned,\n * zero-filled), passed in its slot and copied to the caller with memmove only after status 0. */\nstatic uint32_t ombr2_run(const void *code, uint64_t *args, uint64_t *result, int has_value, const ombr2_out *o,\n                          unsigned no)\n{\n    if (ombr_active)\n        return OMEGA_REENTRY;\n    ombr_active = 1;\n    unsigned char *top = ombr_stack();\n    if (!top) {\n        ombr_active = 0;\n        return OMEGA_NO_STACK;\n    }\n    unsigned char *buf[6] = {0};\n    for (unsigned i = 0; i < no; i++) {\n        top -= (o[i].n + 15u) / 16u * 16u;\n        memset(top, 0, o[i].n);\n        buf[i] = top;\n        args[o[i].slot] = (uint64_t)(uintptr_t)top;\n    }\n    uint64_t v = 0;\n    uint32_t s = ombr_enter(code, args, &ombr_rt_table, &v, top);\n    if (s == OMEGA_OK) {\n        for (unsigned i = 0; i < no; i++)\n            memmove(o[i].dst, buf[i], o[i].n);\n        *result = has_value ? v : 0u;\n    }\n    ombr_active = 0;\n    return s;\n}\n~__asm__(\".section .text.omega_bridge,\\\"ax\\\",@progbits\\n.balign 4\\n.local ombr2_code_~\\n.hidden ombr2_code_~\\nombr2_code_~:\\n.byte ~\\n.previous\\n\");\n~static const char ombr2_ident_~[] = \"~\";\n__attribute__((visibility(\"default\"))) const char *omega2_ident_~(void)\n{\n    return ombr2_ident_~;\n}\n~omega-ident 1 unit=~ abi=2 profile=OM-2 src=~ omc=~__asm__(\".section .text.omega_bridge,\\\"ax\\\",@progbits\\n.balign 4\\n.globl ombr2_entry_~\\n.hidden ombr2_entry_~\\nombr2_entry_~:\\nhint #34\\nb ombr2_code_~+~\\n.previous\\n\");\nextern const unsigned char ombr2_entry_~[] __attribute__((visibility(\"hidden\")));\n~/* ~ */\n__attribute__((visibility(\"default\"))) uint32_t omega2_~(uint64_t *result~)\n{\n    ombr_span sp[7];\n    unsigned ns = 0;\n    uint64_t a[6] = {0};\n    ombr2_out ou[6] = {{0, 0, 0}};\n    unsigned no = 0;\n    if (ombr_span_add(sp, &ns, result, 1u, 1u, 8u, 1))\n        return OMEGA_BAD_ARG;\n~, uint64_t o_~, ~const ~ *o_~, uint64_t o_~_len~    if (ombr_span_add(sp, &ns, o_~, o_~_len, ~u, ~))\n        return OMEGA_BAD_ARG;\n~    a[~] = (uint64_t)(uintptr_t)o_~;\n~] = o_~    if (ombr2_view(sp, &ns, o_~    if (ombr2_fixed(sp, &ns, o_~_len;\n~2))\n        return OMEGA_BAD_ARG;\n    ou[no].slot = ~u;\n    ou[no].n = ~u;\n    ou[no].dst = o_~;\n    no++;\n~1u, ~    if (ombr2_overlap(sp, ns))\n        return OMEGA_BAD_ARG;\n    return ombr2_run(ombr2_entry_~, a, result, ~, ou, no);\n}\n~#define OMEGA2_IDENT_~ \"~\"\nconst char *omega2_ident_~(void);\n~ */\nuint32_t omega2_~);\n~# ~\nomega2_~ = lib.omega2_~.argtypes = [_res~]\nomega2_~.restype = ctypes.c_uint32\n~, _u64~, ctypes.c_char_p~, ctypes.POINTER(ctypes.~)~omega2_ident_~.argtypes = []\nomega2_ident_~.restype = ctypes.c_char_p\nOMEGA2_IDENT_~ = b\"~\"\nif omega2_ident_~() != OMEGA2_IDENT_~:\n    raise ImportError(\"libomega_native.so is not the library this binding was generated with: the identity of unit ~ differs\")\n~\n~    // ~\n    pub fn omega2_~(result: *mut u64~) -> u32;\n~, o_~: u64~: *const ~: *mut ~_len: u64~    pub fn omega2_ident_~() -> *const u8;\n}\n#[allow(dead_code, non_upper_case_globals)]\npub const OMEGA2_IDENT_~: &str = \"~\";\n#[allow(dead_code)]\n#[link(name = \"omega_native\")]\nunsafe extern \"C\" {\n~// ~\npub extern fn omega2_~(result: ?*u64~) u32;\n~: ?[*]const ~: ?[*]~pub const OMEGA2_IDENT_~ = \"~\";\npub extern fn omega2_ident_~() [*:0]const u8;\n~\n// ~\nfunc Omega2_~(result *uint64~) uint32 {\n\treturn uint32(C.omega2_~((*C.uint64_t)(unsafe.Pointer(result))~))\n}\n~ uint64~ unsafe.Pointer~_len uint64~, C.uint64_t(o_~)~, (*C.~)(o_~_len)~\nconst Omega2Ident_~ = \"~\"\n\nfunc Omega2_ident_~() string {\n\treturn C.GoString(C.omega2_ident_~())\n}\n~/* Generated by omega-bridge src/native.om: the C API of the ABI v2 units in libomega_native\n * (docs/NATIVE-ABI.md, ABI v2). Each function calls omega2_<name> and calls abort() on a nonzero status.\n * Regenerate it; do not edit it. */\n#ifndef OMEGA_API_H\n#define OMEGA_API_H\n#include <stddef.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include \"omega_native.h\"\n#ifdef __cplusplus\n#define OMBR_ASSERT static_assert\nextern \"C\" {\n#else\n#define OMBR_ASSERT _Static_assert\n#endif\n~#ifdef __cplusplus\n}\n#endif\n#endif\n~#define ~ ~typedef struct {\n~} ~;\nOMBR_ASSERT(sizeof(~) == ~, \"layout ~ size\");\n~OMBR_ASSERT(offsetof(~, ~ field ~\");\n~    ~[~];\n~    uint8_t ombr_pad~ */\nstatic inline ~void~uint64_t~int64_t~(~)\n{\n    uint64_t r = 0;\n    if (omega2_~(&r~) != OMEGA_OK)\n        abort();\n~    (void)r;\n}\n~    return r;\n}\n~    return (int64_t)r;\n}\n~, ~ o_~ *o_~, size_t o_~, (uint8_t *)o_~, (const uint8_t *)o_~, (uint64_t)o_~]~ = lib."
text tn "uint8_t~uint16_t~uint32_t~uint64_t~int8_t~int16_t~int32_t~int64_t~c_uint8~c_uint16~c_uint32~c_uint64~c_int8~c_int16~c_int32~c_int64~u8~u16~u32~u64~i8~i16~i32~i64~uint8_t~uint16_t~uint32_t~uint64_t~int8_t~int16_t~int32_t~int64_t"
note shx: SHA-256 (FIPS 180-4) K[0..63] then H0[0..7], 8 hex digits each.
text shx ""
note fa: the out-of-line API fragments (outputs apih and apic), separated by ~: 0 the close of a
note signature comment, 1 the end of a prototype, 2 the apih header's start, 3 the apic file's start.
text fa " */\n~);\n~/* Generated by omega-bridge src/native.om: the C API of the ABI v2 units in libomega_native\n * (docs/NATIVE-ABI.md, ABI v2), declarations only (output apih). The definitions are the generated C\n * file of output apic: each calls omega2_<name> and calls abort() on a nonzero status. Including this\n * header references no C library function. Regenerate it; do not edit it. */\n#ifndef OMEGA_API_DECL_H\n#define OMEGA_API_DECL_H\n#include <stddef.h>\n#include <stdint.h>\n#include \"omega_native.h\"\n#ifdef __cplusplus\n#define OMBR_ASSERT static_assert\nextern \"C\" {\n#else\n#define OMBR_ASSERT _Static_assert\n#endif\n~/* Generated by omega-bridge src/native.om: the definitions of the C API declared in\n * omega_api_decl.h (output apic). Each calls omega2_<name> and calls abort() on a nonzero status.\n * Regenerate it; do not edit it. */\n#include <stdlib.h>\n#include \"omega_api_decl.h\"\n"
fn ofa k ulong to void
c = ulong 0
for i ulong len fa
b = get fa i
if eq b 126
c = add c 1
else
if eq c k
ob b
end
end
end
end
note ofv / otn: fragment k of fv / tn.
fn ofv k ulong to void
c = ulong 0
for i ulong len fv
b = get fv i
if eq b 126
c = add c 1
else
if eq c k
ob b
end
end
end
end
fn otn k ulong to void
c = ulong 0
for i ulong len tn
b = get tn i
if eq b 126
c = add c 1
else
if eq c k
ob b
end
end
end
end
note ---- SHA-256 of the unit's source bytes (the identity's src) ----
note rr: a 32-bit value rotated right by n (1 .. 31).
fn rr x ulong n ulong to ulong
ret and or shr x n shl x sub 32 n 4294967295
end
fn sg0 a ulong to ulong
ret xor xor rr a 2 rr a 13 rr a 22
end
fn sg1 e ulong to ulong
ret xor xor rr e 6 rr e 11 rr e 25
end
fn chf e ulong f ulong g ulong to ulong
ret xor and e f and xor e 4294967295 g
end
fn mjf a ulong b ulong c ulong to ulong
ret xor xor and a b and a c and b c
end
note shkin: K and the initial hash value from shx.
fn shkin to void
for i ulong 72
v = ulong 0
for j ulong 8
c = ulong get shx add mul i 8 j
if lt c 58
v = or shl v 4 sub c 48
else
v = or shl v 4 sub c 87
end
end
put shk i v
end
for i ulong 8
put shh i get shk add 64 i
end
end
note shsch: the message schedule shw of the block in shb.
fn shsch to void
for i ulong 16
j = mul i 4
v = shl ulong get shb j 24
v = or v shl ulong get shb add j 1 16
v = or v shl ulong get shb add j 2 8
v = or v ulong get shb add j 3
put shw i v
end
for i ulong 48
t = add i 16
x = get shw sub t 15
y = get shw sub t 2
s0 = xor xor rr x 7 rr x 18 shr x 3
s1 = xor xor rr y 17 rr y 19 shr y 10
x = and add get shw sub t 16 s0 4294967295
put shw t and add add x get shw sub t 7 s1 4294967295
end
end
note shrnd: round i on the working words shv (a .. h): the words move down one place, e and a get
note the new values.
fn shrnd i ulong to void
e = get shv 4
t1 = add add get shv 7 sg1 e chf e get shv 5 get shv 6
t1 = and add add t1 get shk i get shw i 4294967295
a = get shv 0
t2 = and add sg0 a mjf a get shv 1 get shv 2 4294967295
for j ulong 7
k = sub 7 j
put shv k get shv sub k 1
end
put shv 4 and add get shv 4 t1 4294967295
put shv 0 and add t1 t2 4294967295
end
note shblk: one 64-byte block of shb into the hash value shh.
fn shblk to void
shsch
for i ulong 8
put shv i get shh i
end
for i ulong 64
shrnd i
end
for i ulong 8
put shh i and add get shh i get shv i 4294967295
end
end
note shpad: byte k of the padded message inb[p .. p+n): the bytes, 0x80, zeros, then from lb the bit
note length, big endian.
fn shpad p ulong n ulong k ulong lb ulong to ulong
if lt k n
ret ulong get inb add p k
end
if eq k n
ret 128
end
if ge k lb
ret and shr mul n 8 mul sub 7 sub k lb 8 255
end
ret 0
end
note shsrc: the SHA-256 of inb[p .. q) into shh.
fn shsrc p ulong q ulong to void
shkin
n = sub q p
nb = div add n 72 64
lb = sub mul nb 64 8
for bk ulong nb
for i ulong 64
put shb i uchar shpad p n add mul bk 64 i lb
end
shblk
end
end
note ohx8: shh as 64 lowercase hex digits.
fn ohx8 to void
for i ulong 8
w = get shh i
for j ulong 8
ob get hx and shr w sub 28 mul j 4 15
end
end
end
note ---- reading OM-2 units ----
note tvis: 1 when token k is the OM-2 word kv[o .. o+n-1], else 0.
fn tvis k ulong o ulong n ulong to ulong
s = get tks k
e = get tke k
if ne sub e s n
ret 0
end
for j ulong n
if ne get inb add s j get kv add o j
ret 0
end
end
ret 1
end
note atkv: 1 when the bytes at i (below q) are kv[o .. o+n-1], else 0.
fn atkv i ulong q ulong o ulong n ulong to ulong
if gt add i n q
ret 0
end
for j ulong n
if ne get inb add i j get kv add o j
ret 0
end
end
ret 1
end
note atsp: 1 when the byte at i (below q) is a space, else 0.
fn atsp i ulong q ulong to ulong
if ge i q
ret 0
end
if ne get inb i 32
ret 0
end
ret 1
end
note lend: where the line starting at i ends (its newline, or q).
fn lend i ulong q ulong to ulong
e = i
while and lt e q ne get inb e 10
e = add e 1
end
ret e
end
note isexp / islay / isbrn: the line at i starts with "export fn " / "layout " / "note bridge ".
fn isexp i ulong q ulong to ulong
if and eq atkv i q 0 6 1 eq atsp add i 6 q 1
if and eq atkv add i 7 q 6 2 1 eq atsp add i 9 q 1
ret 1
end
end
ret 0
end
fn islay i ulong q ulong to ulong
if and eq atkv i q 36 6 1 eq atsp add i 6 q 1
ret 1
end
ret 0
end
fn isbrn i ulong q ulong to ulong
if and eq atkv i q 50 4 1 eq atsp add i 4 q 1
if and eq atkv add i 5 q 54 6 1 eq atsp add i 11 q 1
ret 1
end
end
ret 0
end
note prof: 1 when the unit p .. q-1 is OM-2: its first line that is not a note (a line whose first word
note is note) is exactly om2; else 0. A first such line that starts with the word om2 but is not exactly
note om2 (om2 diag, om2 fmt) is refused: that unit is not compiled to code.
fn prof p ulong q ulong to ulong
i = p
while lt i q
e = lend i q
s = i
while and lt s e eq get inb s 32
s = add s 1
end
nt = ulong 0
if eq atkv s e 50 4 1
if or eq add s 4 e eq atsp add s 4 e 1
nt = 1
end
end
if eq nt 0
if and eq s i eq sub e i 3
if eq atkv i e 11 3 1
ret 1
end
end
if eq atkv s e 11 3 1
if or eq add s 3 e eq atsp add s 3 e 1
trap 10
end
end
ret 0
end
i = add e 1
end
ret 0
end
note ismain: 1 when bytes s .. e-1 are main.
fn ismain s ulong e ulong to ulong
if ne sub e s 4
ret 0
end
for j ulong 4
if ne get inb add s j get kw add 28 j
ret 0
end
end
ret 1
end
note bname: refuse a bound name that is not a C identifier, is main, or repeats an earlier bound name
