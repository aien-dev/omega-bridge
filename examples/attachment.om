fn total a view ulong 4 to ulong
s = ulong 0
for i ulong 4
s = add s get a i
end
ret s
end
fn bump a edit uchar 4 to void
for i ulong 4
put a i add get a i 1
end
end
fn narrow x ulong to uchar
ret uchar x
end
fn divide a long b long to long
ret div a b
end
fn copy a edit ulong 4 b view ulong 4 to void
for i ulong 4
put a i get b i
end
end
