fn mputb b uchar to void
m = get mc 0
put msg m b
put mc 0 add m 1
end

fn mputn v ulong to void
d = new uchar 20 0
i = ulong 0
x = v
put d 0 uchar add rem x 10 48
x = div x 10
i = add i 1
while gt x 0
put d i uchar add rem x 10 48
x = div x 10
i = add i 1
end
j = i
while gt j 0
j = sub j 1
mputb get d j
end
end

fn fail code ulong to void
put mc 0 0
mputb 116
mputb 111
mputb 99
mputb 58
mputb 32
mputb 108
mputb 105
mputb 110
mputb 101
mputb 32
mputn get line 0
mputb 58
mputb 32
mputb 101
mputb 114
mputb 114
mputb 111
mputb 114
mputb 32
mputn code
mputb 10
w = write 2 msg 0 get mc 0
if eq code 24
w = write 2 capmsg 0 len capmsg
end
exit int code
end

fn e_b c ulong to void
o = get oc 0
if ge o 262144
fail 14
end
put outb o uchar c
put oc 0 add o 1
end

fn e_src a ulong n ulong to void
i = ulong 0
while lt i n
e_b ulong get src add a i
i = add i 1
end
end

fn e_s0 to void
e_b 32
end

fn isw w ulong to ulong
if and eq get tk 0 1 eq get tw 0 w
ret 1
end
ret 0
end

fn tok_num to void
v = ulong 0
i = ulong 0
minus = ulong 0
p = get ts 0
if eq get src p 45
minus = 1
i = 1
end
while lt i get tl 0
b = get src add p i
v = add mul v 10 sub ulong b ulong 48
i = add i 1
end
if eq minus 1
v = sub 0 v
end
put tw 0 v
put tk 0 2
end

note Match the seeded tok_text span rules. Decode only in a text declaration.
fn tok_text to void
put cur 0 add get cur 0 1
put tw 0 get cur 0
go = ulong 1
while eq go 1
if ge get cur 0 get slen 0
fail 22
end
b = get src get cur 0
if eq b 10
fail 22
end
if eq b 34
go = 0
else
put cur 0 add get cur 0 1
if eq b 92
if ge get cur 0 get slen 0
fail 22
end
if eq get src get cur 0 10
fail 22
end
put cur 0 add get cur 0 1
end
end
end
put tl 0 sub get cur 0 get tw 0
put cur 0 add get cur 0 1
put tk 0 4
if lt get cur 0 get slen 0
if gt get src get cur 0 32
fail 22
end
end
end

fn tok2 c uchar to void
if eq c 34
tok_text
ret
end
put ts 0 get cur 0
w = ulong 0
sh = ulong 0
n = ulong 0
go = ulong 1
while eq go 1
if ge get cur 0 get slen 0
go = 0
else
b = get src get cur 0
if le b 32
go = 0
else
if lt n 8
w = or w shl ulong b sh
sh = add sh 8
end
n = add n 1
put cur 0 add get cur 0 1
end
end
end
put tw 0 w
put tl 0 n
f = get src get ts 0
num = ulong 0
if eq f 45
num = 1
end
if and ge f 48 le f 57
num = 1
end
if eq num 1
tok_num
else
put tk 0 1
end
end

fn tok to void
if eq get held 0 1
put held 0 0
ret
end
go = ulong 1
while eq go 1
if ge get cur 0 get slen 0
put tk 0 3
ret
end
c = get src get cur 0
if or or eq c 32 eq c 9 eq c 13
put cur 0 add get cur 0 1
else
if eq c 10
put cur 0 add get cur 0 1
put line 0 add get line 0 1
put tk 0 0
ret
end
if lt c 32
fail 16
end
tok2 c
if eq isw 1702129518 1
while lt get cur 0 get slen 0
if eq get src get cur 0 10
ret
end
put cur 0 add get cur 0 1
end
end
ret
end
end
end

