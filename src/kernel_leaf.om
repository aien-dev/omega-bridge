note Isolated kernel-leaf instruction envelope, not a loader or code validator.
note Input must be exact compiler-produced kleaf bytes with source/compiler custody.
note Target matches Linux 7.0.0-1019-nvidia tracing 4,2 and PAC property, no BTI config.
note No arbitrary external symbols, effects, C implementation, device or kernel access.
global src uchar 4097
global out uchar 65536
global cursor ulong 1
global digits uchar 20
text head ".text\n.p2align 3\n.Lkleaf_start:\n"
text entry ".global omega_kernel_unit\n.type omega_kernel_unit,%function\nomega_kernel_unit:\n"
text inst ".inst "
text tail ".size omega_kernel_unit,.-omega_kernel_unit\n.pushsection __patchable_function_entries,\"awo\",%progbits,.Lkleaf_start\n.p2align 3\n.xword .Lkleaf_start\n.popsection\n.section .note.GNU-stack,\"\",%progbits\n.section .note.gnu.property,\"a\"\n.p2align 3\n.long 2f-1f,6f-3f,5\n1: .asciz \"GNU\"\n2: .p2align 3\n3: .long 0xc0000000,5f-4f\n4: .long 2\n5: .p2align 3\n6:\n"
fn putc c uchar to void
p = get cursor 0
if ge p len out
trap 10
end
put out p c
put cursor 0 add p 1
end
fn append id ulong to void
if eq id 0
for i ulong len head
putc get head i
end
end
if eq id 1
for i ulong len entry
putc get entry i
end
end
if eq id 2
for i ulong len inst
putc get inst i
end
end
if eq id 3
for i ulong len tail
putc get tail i
end
end
end
fn decimal v ulong to void
n = ulong 0
x = v
go = true
while go
put digits n uchar add rem x 10 48
n = add n 1
x = div x 10
if eq x 0
go = false
end
end
while gt n 0
n = sub n 1
p = get cursor 0
if ge p len out
trap 10
end
put out p get digits n
put cursor 0 add p 1
end
p = get cursor 0
put out p uchar 10
put cursor 0 add p 1
end
fn word at ulong to ulong
v = ulong 0
for i ulong 4
v = or v shl ulong get src add at i mul i 8
end
ret v
end
fn main to int
n = ulong 0
go = true
while go
if ge n len src
ret 110
end
r = read 0 src n sub len src n
if lt r 0
ret 110
end
if eq r 0
go = false
else
n = add n ulong r
end
end
if or or lt n 20 gt n 4096 ne rem n 4 0
ret 110
end
note Wolfram FromDigits["d503201f",16] = 3573751839, matches configured GCC ftrace oracle.
for i ulong 4
if ne word mul i 4 3573751839
ret 110
end
end
append 0
p = ulong 0
while lt p n
if eq p 8
append 1
end
append 2
decimal word p
p = add p 4
end
append 3
p = ulong 0
while lt p get cursor 0
r = write 1 out p sub get cursor 0 p
if le r 0
ret 110
end
p = add p ulong r
end
ret 0
end
