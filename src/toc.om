ret 8
end
if eq w 1735290732
ret 9
end
ret 0
end

fn signed t ulong to ulong
if and ge t 6 le t 9
ret 1
end
ret 0
end

fn same_name o ulong n ulong to ulong
if ne n get tl 0
ret 0
end
i = ulong 0
while lt i n
if ne get src add o i get src add get ts 0 i
ret 0
end
i = add i 1
end
ret 1
end

fn loc_of to ulong
i = ulong 0
while lt i get nloc 0
if eq same_name get loc_off i get loc_nl i 1
ret i
end
i = add i 1
end
ret 99
end

