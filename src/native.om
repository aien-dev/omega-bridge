note native.om: omega-bridge native call ABI v1 binding generator (docs/NATIVE-ABI.md).
note Input on stdin, one or more units: the unit's .om source, a 0 byte, its code length as 8 decimal
note digits, then the function-mode machine code the seeded compiler wrote for that source.
note Output on stdout, only after every unit is accepted: one C file that embeds each code unchanged
note and exports uint32_t omega_<name>(uint64_t *result, ...) per unit. A unit holds one function;
note parameters are ulong or long scalars, or edit/view arrays of ulong or uchar; the result is ulong,
note long or void. Anything else is refused: trap 10 (exit 110) and no output.
global inb uchar 1048576
global outb uchar 4194304
global st ulong 8
global tks ulong 40
global tke ulong 40
global pk ulong 6
global pl ulong 6
global ps ulong 6
global pe ulong 6
global dg uchar 24
text hx "0123456789abcdef"
text kw "toeditviewulonglongucharvoidmain"
text fr "__asm__(\".section .text.omega_bridge,\\\"ax\\\",@progbits\\n.balign 4\\n.globl ombr_code_~\\n.hidden ombr_code_~\\nombr_code_~:\\n.byte ~\\n.previous\\n\");\nextern const unsigned char ombr_code_~[] __attribute__((visibility(\"hidden\")));\n__attribute__((visibility(\"default\"))) uint32_t omega_~(uint64_t *result~, uint64_t o_~, void *o_~, const void *o_~_len~)\n{\n    ombr_span sp[7];\n    unsigned ns = 0;\n    uint64_t a[6] = {0};\n    if (ombr_span_add(sp, &ns, result, 1u, 1u, 8u, 1))\n        return OMEGA_BAD_ARG;\n~    if (ombr_span_add(sp, &ns, o_~, o_~_len, ~u, ~))\n        return OMEGA_BAD_ARG;\n    a[~] = (uint64_t)(uintptr_t)o_~;\n~    a[~] = o_~    if (ombr_overlap(sp, ns))\n        return OMEGA_BAD_ARG;\n    return ombr_run(ombr_code_~, a, result, ~);\n}\n"
text pre "/* Generated by omega-bridge src/native.om: native call ABI v1 (docs/NATIVE-ABI.md).\n * The Omega machine code below is embedded byte for byte as the seeded compiler wrote it.\n * This file only adapts the C calling convention to it. Regenerate it; do not edit it. */\n#include <setjmp.h>\n#include <stdint.h>\n#define OMEGA_OK 0u\n#define OMEGA_BAD_ARG 32u\n#define OMEGA_REENTRY 33u\n#define OMEGA_BAD_RT 34u\ntypedef struct ombr_rt { void (*entry[32])(struct ombr_rt *, uint64_t); } ombr_rt;\ntypedef struct ombr_span { uintptr_t lo, hi; int w; } ombr_span;\nstatic _Thread_local jmp_buf *ombr_jb;\nstatic _Thread_local int ombr_active;\nuint64_t ombr_enter(const void *code, const uint64_t *args, ombr_rt *rt) __attribute__((visibility(\"hidden\")));\n__asm__(\".text\\n.balign 4\\n.globl ombr_enter\\n.hidden ombr_enter\\n.type ombr_enter,%function\\nombr_enter:\\n\"\n        \"stp x29,x30,[sp,#-160]!\\nmov x29,sp\\nstp x19,x20,[sp,#16]\\nstp x21,x22,[sp,#32]\\n\"\n        \"stp x23,x24,[sp,#48]\\nstp x25,x26,[sp,#64]\\nstp x27,x28,[sp,#80]\\nstp d8,d9,[sp,#96]\\n\"\n        \"stp d10,d11,[sp,#112]\\nstp d12,d13,[sp,#128]\\nstp d14,d15,[sp,#144]\\n\"\n        \"mov x16,x0\\nmov x17,x1\\nmov x7,x2\\nldp x0,x1,[x17]\\nldp x2,x3,[x17,#16]\\nldp x4,x5,[x17,#32]\\n\"\n        \"blr x16\\n\"\n        \"ldp d14,d15,[sp,#144]\\nldp d12,d13,[sp,#128]\\nldp d10,d11,[sp,#112]\\nldp d8,d9,[sp,#96]\\n\"\n        \"ldp x27,x28,[sp,#80]\\nldp x25,x26,[sp,#64]\\nldp x23,x24,[sp,#48]\\nldp x21,x22,[sp,#32]\\n\"\n        \"ldp x19,x20,[sp,#16]\\nldp x29,x30,[sp],#160\\nret\\n.size ombr_enter,.-ombr_enter\\n\");\nstatic void ombr_trap(ombr_rt *rt, uint64_t code)\n{\n    (void)rt;\n    longjmp(*ombr_jb, code >= 1u && code <= 14u ? (int)code : (int)OMEGA_BAD_RT);\n}\nstatic void ombr_no_entry(ombr_rt *rt, uint64_t x)\n{\n    (void)rt;\n    (void)x;\n    longjmp(*ombr_jb, (int)OMEGA_BAD_RT);\n}\nstatic int ombr_span_add(ombr_span *sp, unsigned *ns, const void *p, uint64_t n, uint64_t want, uint64_t es, int w)\n{\n    uintptr_t lo = (uintptr_t)p;\n    if (!p || n != want || lo % es != 0u || n > (UINTPTR_MAX - lo) / es)\n        return 1;\n    sp[*ns].lo = lo;\n    sp[*ns].hi = lo + n * es;\n    sp[*ns].w = w;\n    (*ns)++;\n    return 0;\n}\nstatic int ombr_overlap(const ombr_span *sp, unsigned ns)\n{\n    for (unsigned i = 0; i < ns; i++)\n        for (unsigned j = i + 1; j < ns; j++)\n            if ((sp[i].w || sp[j].w) && sp[i].lo < sp[j].hi && sp[j].lo < sp[i].hi)\n                return 1;\n    return 0;\n}\nstatic uint32_t ombr_run(const void *code, const uint64_t *args, uint64_t *result, int has_value)\n{\n    if (ombr_active)\n        return OMEGA_REENTRY;\n    ombr_rt rt;\n    for (int i = 0; i < 32; i++)\n        rt.entry[i] = ombr_no_entry;\n    rt.entry[2] = ombr_trap;\n    jmp_buf jb;\n    ombr_jb = &jb;\n    ombr_active = 1;\n    int s = setjmp(jb);\n    if (s != 0) {\n        ombr_active = 0;\n        ombr_jb = 0;\n        return (uint32_t)s;\n    }\n    uint64_t v = ombr_enter(code, args, &rt);\n    ombr_active = 0;\n    ombr_jb = 0;\n    *result = has_value ? v : 0u;\n    return OMEGA_OK;\n}\n"
note ob: append one byte to the output pool (trap 6 when it is full).
fn ob b uchar to void
n = get st 1
if ge n len outb
trap 6
end
put outb n b
put st 1 add n 1
end
note orng: copy input bytes s .. e-1 to the output.
fn orng s ulong e ulong to void
i = s
while lt i e
ob get inb i
i = add i 1
end
end
note odec: v in decimal.
fn odec v ulong to void
x = v
n = ulong 0
put dg n uchar add rem x 10 48
n = add n 1
x = div x 10
while ne x 0
put dg n uchar add rem x 10 48
n = add n 1
x = div x 10
end
while gt n 0
n = sub n 1
ob get dg n
end
end
note ohex: one byte as 0xNN.
fn ohex b uchar to void
ob uchar 48
ob uchar 120
ob get hx shr b 4
ob get hx and b 15
end
note opre: the fixed runtime part of the C file.
fn opre to void
for i ulong len pre
ob get pre i
end
end
note ofr: fragment k of fr (fragments are separated by ~, byte 126).
fn ofr k ulong to void
c = ulong 0
for i ulong len fr
b = get fr i
if eq b 126
c = add c 1
else
if eq c k
ob b
end
end
end
end
note tkis: 1 when token k is the keyword kw[o .. o+n-1], else 0.
fn tkis k ulong o ulong n ulong to ulong
s = get tks k
e = get tke k
if ne sub e s n
ret 0
end
for j ulong n
if ne get inb add s j get kw add o j
ret 0
end
end
ret 1
end
note tknum: token k as a decimal number of 1 .. 8 digits.
fn tknum k ulong to ulong
s = get tks k
e = get tke k
if or eq s e gt sub e s 8
trap 10
end
v = ulong 0
for j ulong sub e s
c = get inb add s j
if or lt c 48 gt c 57
trap 10
end
v = add mul v 10 ulong sub c 48
end
ret v
end
note tokln: split the line that starts at p (ending at a newline or at q) into tokens at spaces.
fn tokln p ulong q ulong to ulong
e = p
while and lt e q ne get inb e 10
e = add e 1
end
n = ulong 0
s = p
i = p
while lt i e
if eq get inb i 32
if gt i s
put tks n s
put tke n i
n = add n 1
end
s = add i 1
end
i = add i 1
end
if gt e s
put tks n s
put tke n e
n = add n 1
end
ret n
end
note oname: the name of token k.
fn oname k ulong to void
orng get tks k get tke k
end
note opn: the name of parameter j.
fn opn j ulong to void
orng get ps j get pe j
end
note sepat: where the 0 byte after the source starting at p is.
fn sepat p ulong to ulong
t = get st 0
q = p
while and lt q t ne get inb q 0
q = add q 1
end
if ge q t
trap 10
end
ret q
end
note isfn: 1 when the bytes at i are "fn ".
fn isfn i ulong to ulong
if ne get inb i 102
ret 0
end
if ne get inb add i 1 110
ret 0
end
if ne get inb add i 2 32
ret 0
end
ret 1
end
note sigln: the start of the one line in p .. q-1 that begins with "fn ".
fn sigln p ulong q ulong to ulong
fl = ulong 0
nf = ulong 0
ls = p
i = p
while lt i q
if eq i ls
if eq isfn i 1
fl = i
nf = add nf 1
end
end
if eq get inb i 10
ls = add i 1
end
i = add i 1
end
if ne nf 1
trap 10
end
ret fl
end
note pkind: the kind of the parameter whose type starts at token ty: 1 ulong, 2 long, 3 edit ulong,
note 4 view ulong, 5 edit uchar, 6 view uchar; 0 when refused.
fn pkind ty ulong nt ulong to ulong
if eq tkis ty 10 5 1
ret 1
end
if eq tkis ty 15 4 1
ret 2
end
w = ulong 0
if eq tkis ty 6 4 1
w = 1
else
if ne tkis ty 2 4 1
ret 0
end
end
if ge add ty 2 nt
ret 0
end
el = add ty 1
if eq tkis el 10 5 1
ret add 3 w
end
if eq tkis el 19 5 1
ret add 5 w
end
ret 0
end
note pparam: record the parameter at token k in slot st 2; return the token after it.
fn pparam k ulong nt ulong to ulong
np = get st 2
if ge np 6
trap 10
end
put ps np get tks k
put pe np get tke k
ki = pkind add k 1 nt
if eq ki 0
trap 10
end
put pk np ki
put st 2 add np 1
if le ki 2
ret add k 2
end
ln = tknum add k 3
if or eq ln 0 gt ln 16777216
trap 10
end
put pl np ln
ret add k 4
end
note parse: read the signature line at fl; parameters into ps pe pk pl, their count into st 2,
note 1 or 0 into st 3 for a function with or without a value.
fn parse fl ulong q ulong to void
nt = tokln fl q
if lt nt 4
trap 10
end
if eq tkis 1 28 4 1
trap 10
end
put st 2 0
k = ulong 2
while eq tkis k 0 2 0
if ge add k 1 nt
trap 10
end
k = pparam k nt
if ge k nt
trap 10
end
end
if ne add k 2 nt
trap 10
end
r = add k 1
hv = ulong 2
if or eq tkis r 10 5 1 eq tkis r 15 4 1
hv = 1
end
if eq tkis r 24 4 1
hv = 0
end
if eq hv 2
trap 10
end
put st 3 hv
end
note codelen: the 8-digit code length after the 0 byte at q, checked against the input.
fn codelen q ulong to ulong
t = get st 0
c0 = add q 9
if gt c0 t
trap 10
end
cl = ulong 0
for j ulong 8
d = get inb add add q 1 j
if or lt d 48 gt d 57
trap 10
end
cl = add mul cl 10 ulong sub d 48
end
if or eq cl 0 ne rem cl 4 0
trap 10
end
if gt cl sub t c0
trap 10
end
ret cl
end
note ecode: the embedded machine code, unchanged.
fn ecode c0 ulong cl ulong to void
ofr 0
oname 1
ofr 1
oname 1
ofr 2
oname 1
ofr 3
for j ulong cl
if gt j 0
ob uchar 44
end
ohex get inb add c0 j
end
ofr 4
oname 1
ofr 5
oname 1
end
note esig: the exported C parameter list.
fn esig to void
ofr 6
for j ulong get st 2
x = get pk j
if le x 2
ofr 7
opn j
else
if or eq x 3 eq x 5
ofr 8
else
ofr 9
end
opn j
ofr 7
opn j
ofr 10
end
end
end
note earr: the checks and argument word for array parameter j of kind x.
fn earr j ulong x ulong to void
ofr 12
opn j
ofr 13
opn j
ofr 14
odec get pl j
ofr 15
if le x 4
odec 8
else
odec 1
end
ofr 15
if or eq x 3 eq x 5
odec 1
else
odec 0
end
ofr 16
odec j
ofr 17
opn j
ofr 18
end
note ebody: argument words, overlap check and the call.
fn ebody to void
ofr 11
for j ulong get st 2
x = get pk j
if le x 2
ofr 19
odec j
ofr 20
opn j
ofr 18
else
earr j x
end
end
ofr 21
oname 1
ofr 22
odec get st 3
ofr 23
end
note unit: accept the unit at p, emit its C, return where the next unit starts.
fn unit p ulong to ulong
q = sepat p
fl = sigln p q
parse fl q
cl = codelen q
c0 = add q 9
ecode c0 cl
esig
ebody
ret add c0 cl
end
note slurp: all of stdin into inb; refuse input that fills the pool.
fn slurp to ulong
t = ulong 0
k = read 0 inb 0 len inb
while gt k 0
t = add t ulong k
k = long 0
if lt t len inb
k = read 0 inb t sub len inb t
end
end
if lt k 0
trap 11
end
if ge t len inb
trap 6
end
ret t
end
fn main to int
t = slurp
put st 0 t
put st 1 0
opre
p = ulong 0
nu = ulong 0
while lt p t
p = unit p
nu = add nu 1
end
if eq nu 0
trap 10
end
o = ulong 0
m = get st 1
while lt o m
w = write 1 outb o sub m o
if le w 0
ret 1
end
o = add o ulong w
end
ret 0
end
