note CUDA C++ CPU simulator, not GPU code or a CUDA ABI
global A0 uint 4096
global A1 uint 4096
global A2 uint 4096
global A3 uint 4096
global A4 uint 4096
global Num uint 1
global Temps uint 128
global Wire uchar 4
global Bytes uchar 16384
text Error "CUDA_SIM_INPUT_REFUSED\n"
fn bad to void
w = write 2 Error 0 len Error
exit 77
end
fn word to ulong
off = ulong 0
while lt off 4
r = read 0 Wire off sub 4 off
if le r 0
bad
end
off = add off ulong r
end
v = ulong 0
for j ulong 4
v = or v shl ulong get Wire j mul j 8
end
ret v
end
fn calc ix ulong to uint
put Temps 0 uint 1
put Temps 1 uint 1
put Temps 2 add get Temps 0 get Temps 1
put Temps 3 uint 1
put Temps 4 add get Temps 2 get Temps 3
put Temps 5 uint 1
put Temps 6 add get Temps 4 get Temps 5
put Temps 7 uint 1
put Temps 8 add get Temps 6 get Temps 7
put Temps 9 uint 1
put Temps 10 add get Temps 8 get Temps 9
put Temps 11 uint 1
put Temps 12 add get Temps 10 get Temps 11
put Temps 13 uint 1
put Temps 14 add get Temps 12 get Temps 13
put Temps 15 uint 1
put Temps 16 add get Temps 14 get Temps 15
put Temps 17 uint 1
put Temps 18 add get Temps 16 get Temps 17
put Temps 19 uint 1
put Temps 20 add get Temps 18 get Temps 19
put Temps 21 uint 1
put Temps 22 add get Temps 20 get Temps 21
put Temps 23 uint 1
put Temps 24 add get Temps 22 get Temps 23
