note Literal conversion copied from omega e5b32567 seed/omc/omc.om lines1811-2116; unchanged algorithm, input buffer renamed.
note ---- float literals: a token is the decimal value fsgn * fnd * 10^fp10, fsuf 0 none / 1 f32 / 2 f64.
note fg_* hold the working state of the one literal being converted (see fparse/fbits/fnorm/fgen).

note ======== float literals: decimal text to IEEE-754 binary32/binary64 ========
note The literal is fnd * 10^fp10. The converter normalizes fnd to a 64-bit significand, applies the
note decimal scale one factor of ten at a time (fmul10/fdiv10) while folding lost bits into one sticky
note flag, then rounds once (froundsh) and packs (fpack). It covers the full IEEE range, subnormals
note included, and refuses (error 8) only a value that rounds to infinity or whose digits do not fit
note in 2^63-1.

note blen: bits needed for x (0 for zero)
fn blen x ulong to ulong
n = ulong 0
while ne x 0
x = shr x 1
n = add n 1
end
ret n
end

note fparse: read the literal text inp[pos, pos+len) into fsgn, fnd, fp10, fsuf (0 none, 1 f32, 2 f64).
note Grammar: [-]digits[.digits][(e|E)[+|-]digits][f32|f64]. At most 2^63-1 significant digits
note (error 8), a dot with no digit after it is error 6, |exponent| <= 999 (error 8).
fn fparse pos ulong ln ulong to void
p = pos
e = add pos ln
put fsgn 0 0
put fsuf 0 0
put fnd 0 0
put fg_fl 0 0
put fg_seen 0 0
if eq get src p 45
put fsgn 0 1
p = add p 1
end
go = true
while and go lt p e
b = get src p
d = sub ulong b 48
if le d 9
if gt get fnd 0 922337203685477580
fail 8
end
if and eq get fnd 0 922337203685477580 gt d 7
fail 8
end
put fnd 0 add mul get fnd 0 10 d
if ne get fg_seen 0 0
put fg_fl 0 add get fg_fl 0 1
end
p = add p 1
else
if and eq b 46 eq get fg_seen 0 0
put fg_seen 0 1
p = add p 1
else
go = false
end
end
end
if and ne get fg_seen 0 0 eq get fg_fl 0 0
fail 6
end
p = fexp p e
p = fsufx p e
if ne p e
fail 6
end
x = mul get fg_esign 0 get fg_ex 0
put fp10 0 sub x long get fg_fl 0
end

note fexp: the exponent of the literal, if present: fg_ex, fg_esign, fg_ed. Returns the new position.
fn fexp p ulong e ulong to ulong
put fg_ex 0 0
put fg_esign 0 1
if and lt p e or eq get src p 101 eq get src p 69
p = add p 1
if lt p e
if or eq get src p 43 eq get src p 45
if eq get src p 45
put fg_esign 0 -1
end
p = add p 1
end
end
put fg_ed 0 0
go = true
while and go lt p e
d = sub ulong get src p 48
if gt d 9
go = false
else
put fg_ex 0 add mul get fg_ex 0 10 long d
if gt get fg_ex 0 999
fail 8
end
put fg_ed 0 add get fg_ed 0 1
p = add p 1
end
end
if eq get fg_ed 0 0
fail 6
end
end
ret p
end

note fsufx: the optional f32/f64 suffix: fsuf 1 or 2. Returns the new position.
fn fsufx p ulong e ulong to ulong
if lt p e
r = sub e p
if ne r 3
fail 6
end
if ne get src p 102
fail 6
end
if and eq get src add p 1 51 eq get src add p 2 50
put fsuf 0 1
else
if and eq get src add p 1 54 eq get src add p 2 52
put fsuf 0 2
else
fail 6
end
end
p = add p 3
end
ret p
end

note fbits: the parsed literal as IEEE bits of type ty (10 f32, 11 f64). Zero keeps the sign (-0.0).
note fmul10 / fdiv10: one exact decimal step on the normalized significand fg_m (value = fg_m * 2^fg_e),
note keeping fg_m in [2^63, 2^64) and folding every lost bit into fg_stk. No rounding happens here.
fn fmul10 to void
m = get fg_m 0
hi = shr m 32
lo = and m 4294967295
p0 = mul lo 10
p1 = mul hi 10
hi2 = add p1 shr p0 32
put fg_low 0 or shl and hi2 4294967295 32 and p0 4294967295
put fg_ov 0 shr hi2 32
fmn10
end

fn fmn10 to void
ov = get fg_ov 0
low = get fg_low 0
s = blen ov
if ne s 0
st = or get fg_stk 0 and low sub shl 1 s 1
put fg_stk 0 st
put fg_m 0 or shl ov sub 64 s shr low s
put fg_e 0 add get fg_e 0 long s
else
put fg_m 0 low
end
end

fn fdiv10 to void
m = get fg_m 0
q = div m 10
if ne rem m 10 0
put fg_stk 0 1
end
s = ulong 0
while lt q 9223372036854775808
q = shl q 1
s = add s 1
end
put fg_m 0 q
put fg_e 0 sub get fg_e 0 long s
end

note froundsh: round fg_m right by sh bits to fg_q, nearest even; the guard and every lower bit
note (plus fg_stk) decide. sh may be 64 (then q is zero and bit 63 is the guard).
fn froundsh sh ulong to void
m = get fg_m 0
q = ulong 0
guard = ulong 0
lost = ulong 0
if eq sh 0
q = m
else
if ge sh 64
guard = shr m 63
lost = and m 9223372036854775807
else
q = shr m sh
guard = and shr m sub sh 1 1
if gt sub sh 1 0
lost = and m sub shl 1 sub sh 1 1
end
end
end
sticky = or get fg_stk 0 lost
if ne guard 0
if or ne sticky 0 eq and q 1 1
q = add q 1
end
end
put fg_q 0 q
end

note fpack: fg_m/fg_e to IEEE bits of fg_ty, including subnormals; a literal that rounds to infinity
note is refused (error 8).
fn fpack to ulong
p = ulong 53
bias = long 1023
maxe = long 2047
emin = long -1022
mb = ulong 52
w = ulong 64
if eq get fg_ty 0 10
p = ulong 24
bias = long 127
maxe = long 255
emin = long -126
mb = ulong 23
w = ulong 32
end
e = add get fg_e 0 63
if ge e emin
sh = sub 64 p
froundsh sh
q = get fg_q 0
if eq q shl 1 p
q = shr q 1
e = add e 1
end
E = add e bias
if ge E maxe
fail 8
end
q = and q sub shl 1 sub p 1 1
q = or q shl ulong E mb
q = or q shl get fsgn 0 sub w 1
ret q
end
k = ulong sub emin e
sh = add sub 64 p k
if gt sh 64
ret shl get fsgn 0 sub w 1
end
froundsh sh
q = get fg_q 0
q = or q shl get fsgn 0 sub w 1
ret q
end

fn fbits ty ulong to ulong
put fg_ty 0 ty
put fg_stk 0 0
if eq get fnd 0 0
w = ulong 64
if eq ty 10
w = ulong 32
end
b = ulong 0
if ne get fsgn 0 0
b = shl ulong 1 sub w 1
end
ret b
end
b = blen get fnd 0
sh = sub 64 b
put fg_m 0 shl get fnd 0 sh
put fg_e 0 sub 0 long sh
p = get fp10 0
if gt p 0
i = ulong 0
n = ulong p
while lt i n
fmul10
i = add i 1
end
else
if lt p 0
i = ulong 0
n = ulong sub 0 p
while lt i n
fdiv10
i = add i 1
end
end
end
ret fpack
end

fn floatkw to ulong
if eq get tl 0 len fword
ok = true
for i ulong len fword
if ne get src add get ts 0 i get fword i
ok = false
end
end
if ok
ret 1
end
end
if eq get tl 0 len bcword
ok = true
for i ulong len bcword
if ne get src add get ts 0 i get bcword i
ok = false
end
end
if ok
ret 2
end
end
if eq get tl 0 len absword
ok = true
for i ulong len absword
if ne get src add get ts 0 i get absword i
ok = false
end
end
if ok
ret 3
end
end
ret 0
end

fn emitfloat op ulong a ulong b ulong to void
emitstr 8
eexpr a
emitstr 9
if eq op 1
e_b 48
else
eexpr b
end
for i ulong len fcall
e_b ulong get fcall i
end
e_dec op
e_comma
emitstr 12
end

fn kwcont to ulong
if or eq get seeded 0 0 ne get target 0 0
ret 0
end
if ne get tl 0 len cntword
ret 0
end
for i ulong len cntword
if ne get src add get ts 0 i get cntword i
ret 0
end
end
ret 1
end

fn econt to void
d = get bd 0
found = false
while gt d 0
d = sub d 1
if or eq get bk d 4 eq get bk d 5
found = true
end
end
if not found
fail 15
end
indent
for i ulong len cntc
e_b ulong get cntc i
end
end
