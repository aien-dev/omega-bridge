fn node kind ulong a ulong b ulong v ulong to ulong
n = get Nodes 0
if ge n 128
die 67
end
put Op n kind
put Left n a
put Right n b
put Val n v
put Nodes 0 add n 1
ret n
end
fn primary to ulong
if eq get Kind 0 40
next
x = expr 1
symbol 41
ret x
end
if eq get Kind 0 2
v = get Value 0
next
ret node 0 0 0 v
end
for j ulong get Count 0
s = add j 2
if matches get Names s get Lens s
next
symbol 91
same add get Count 0 3
symbol 93
ret node 1 0 0 add j 1
end
end
s = add get Count 0 2
if matches get Names s get Lens s
next
ret node 2 0 0 0
end
die 65
ret 0
end
fn prec c ulong to ulong
if eq c 124
ret 1
end
if eq c 94
ret 2
end
if eq c 38
ret 3
end
if or eq c 43 eq c 45
ret 4
end
if eq c 42
ret 5
end
ret 0
end
fn opcode c ulong to ulong
if eq c 43
ret 3
end
if eq c 45
ret 4
end
if eq c 42
ret 5
end
if eq c 38
ret 6
end
if eq c 94
ret 7
end
ret 8
end
fn expr min ulong to ulong
d = get Depth 0
if ge d 16
die 67
end
put Depth 0 add d 1
x = primary
go = true
while go
c = get Kind 0
p = prec c
if lt p min
go = false
else
next
y = expr add p 1
x = node opcode c x y 0
end
end
put Depth 0 d
ret x
end
fn emitb c uchar to void
p = get Used 0
if ge p len Out
die 67
end
put Out p c
put Used 0 add p 1
end
fn number v ulong to void
n = ulong 0
while or ne v 0 eq n 0
put Dig n uchar add rem v 10 48
n = add n 1
v = div v 10
end
while gt n 0
n = sub n 1
emitb get Dig n
end
end
fn emit k ulong to void
if eq k 0
for j ulong len H0
emitb get H0 j
end
end
if eq k 1
for j ulong len H1
emitb get H1 j
end
end
if eq k 2
for j ulong len H2
emitb get H2 j
end
end
if eq k 3
for j ulong len H3
emitb get H3 j
end
end
if eq k 4
for j ulong len H4
emitb get H4 j
end
