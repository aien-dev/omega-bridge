note SPDX-License-Identifier: AGPL-3.0-only
note Native test-only source mutant builder. One selector byte then Omega source.
note Requires exactly one source occurrence; refuses ambiguous or absent mutation.
global src uchar 65536
global dst uchar 65536
global used ulong 1
global fill ulong 1
global pick uchar 1
text before "and q 1\nadd 32767\nif not sarray s get want 0 get want 1\nret div q 4\nret gt a b\nkins 34173473 5 0 17812480\n"
text after "and q 0\nadd 32768\nif false\nret rem q 8\nret ge a b\nkins 34173472 5 4194304 17812480\n"
global span ulong 4
fn select mode ulong to void
k = ulong 0
start = ulong 0
for i ulong len before
if eq get before i 10
if eq k mode
put span 0 start
put span 1 sub i start
end
start = add i 1
k = add k 1
end
end
k = 0
start = 0
for i ulong len after
if eq get after i 10
if eq k mode
put span 2 start
put span 3 sub i start
end
start = add i 1
k = add k 1
end
end
end
fn matches p ulong to bool
n = get span 1
if gt n sub get used 0 p
ret false
end
for i ulong n
if ne get src add p i get before add get span 0 i
ret false
end
end
ret true
end
fn append c uchar to void
if ge get fill 0 len dst
exit 65
end
put dst get fill 0 c
put fill 0 add get fill 0 1
end
fn main to int
n = read 0 pick 0 1
if ne n 1
ret 64
end
if gt get pick 0 5
ret 64
end
select ulong get pick 0
more = true
while and more lt get used 0 len src
n = read 0 src get used 0 sub len src get used 0
if lt n 0
ret 74
end
if eq n 0
more = false
end
put used 0 add get used 0 ulong n
end
if eq get used 0 len src
ret 65
end
p = ulong 0
count = ulong 0
while lt p get used 0
if matches p
for i ulong get span 3
append get after add get span 2 i
end
p = add p get span 1
count = add count 1
else
append get src p
p = add p 1
end
end
if ne count 1
ret 65
end
p = 0
while lt p get fill 0
n = write 1 dst p sub get fill 0 p
if le n 0
ret 74
end
p = add p ulong n
end
ret 0
end
