if eq k 2
for j ulong len C3
emitb get C3 j
end
end
end
fn opword k ulong to void
p = ulong 0
q = ulong 3
for j ulong len Ops
if eq q k
if ne get Ops j 32
emitb get Ops j
end
end
if eq get Ops j 32
q = add q 1
end
end
