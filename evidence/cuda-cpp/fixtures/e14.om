put Temps 100 add get Temps 98 get Temps 99
put Temps 101 uint 1
put Temps 102 add get Temps 100 get Temps 101
put Temps 103 uint 1
put Temps 104 add get Temps 102 get Temps 103
put Temps 105 uint 1
put Temps 106 add get Temps 104 get Temps 105
put Temps 107 uint 1
put Temps 108 add get Temps 106 get Temps 107
put Temps 109 uint 1
put Temps 110 add get Temps 108 get Temps 109
put Temps 111 uint 1
put Temps 112 add get Temps 110 get Temps 111
put Temps 113 uint 1
put Temps 114 add get Temps 112 get Temps 113
put Temps 115 uint 1
put Temps 116 add get Temps 114 get Temps 115
put Temps 117 uint 1
put Temps 118 add get Temps 116 get Temps 117
put Temps 119 uint 1
put Temps 120 add get Temps 118 get Temps 119
put Temps 121 uint 1
put Temps 122 add get Temps 120 get Temps 121
put Temps 123 uint 1
put Temps 124 add get Temps 122 get Temps 123
put Temps 125 uint 1
put Temps 126 add get Temps 124 get Temps 125
ret get Temps 126
end
fn main to int
blocks = word
threads = word
n = word
if or eq blocks 0 gt blocks 4096
bad
end
if or eq threads 0 gt threads 4096
bad
end
cover = mul blocks threads
if or gt cover 4096 gt n 4096
bad
end
put Num 0 uint n
for ix ulong n
put A0 ix uint word
end
for ix ulong n
put A1 ix uint word
end
for ix ulong n
put A2 ix uint word
end
r = read 0 Wire 0 1
if ne r 0
bad
end
ret execute cover n
end
fn execute cover ulong n ulong to int
for ix ulong n
if lt ix cover
put A0 ix calc ix
end
pack ix ulong get A0 ix
end
off = ulong 0
while lt off mul n 4
r = write 1 Bytes off sub mul n 4 off
if le r 0
bad
end
off = add off ulong r
end
ret 0
end
fn pack ix ulong v ulong to void
for j ulong 4
p = add mul ix 4 j
b = uchar and shr v mul j 8 255
put Bytes p b
end
end
