end

fn options_server start ulong lim ulong to int
 i = skipws add start 1 lim
 count = ulong 0
 put target 0 0
 put finish 0 0
 while lt i lim
 i = skipws i lim
 if ge i lim
 ret 3
 end
 if eq get source i 125
 if ne count 1
 ret 5
 end
 ret 0
 end
 keypos = i
 if ne get source keypos 34
 ret 3
 end
 ep = strend keypos lim
 if eq ep 0
 ret 3
 end
 kc = keycode keypos ep
 if eq kc 9
 ret 7
 end
 j = skipws add ep 1 lim
 if or ge j lim ne get source j 58
 ret 3
 end
 vpos = skipws add j 1 lim
 vend = valueend vpos lim
 if eq vend 0
 ret 3
 end
 if eq kc 5
 count = add count 1
 if lt vpos lim
 if eq get source vpos 91
 z = arrend vpos lim
 if eq z 0
 ret 3
 end
 put target 0 vpos
 put finish 0 add z 1
 else
 put target 0 0
 put finish 0 0
 end
 end
 end
 i = skipws vend lim
 if lt i lim
 if eq get source i 44
 i = add i 1
 else
 if ne get source i 125
 ret 3
 end
 end
 end
 end
 ret 3
end

fn inspect_tool start ulong lim ulong to int
 i = skipws add start 1 lim
 put parsed 0 0
 put target 0 0
 put fpos 0 0
 put finish 0 0
 while lt i lim
 i = skipws i lim
 if ge i lim
 ret 3
 end
 if eq get source i 125
 i = lim
 else
 keypos = i
 if ne get source keypos 34
 ret 3
 end
 ep = strend keypos lim
 if eq ep 0
 ret 3
 end
 kc = keycode keypos ep
 if eq kc 9
 ret 7
 end
 j = skipws add ep 1 lim
 if or ge j lim ne get source j 58
 ret 3
 end
 vpos = skipws add j 1 lim
 vend = valueend vpos lim
 if eq vend 0
 ret 3
 end
 if eq kc 2
 if ne get parsed 0 0
 ret 7
 end
 put parsed 0 2
 if lt vpos lim
 if eq get source vpos 34
 ve = strend vpos lim
 if eq ve 0
 ret 3
 end
 cv = chatvalue vpos ve
 if eq cv 2
 ret 7
 end
 if eq cv 1
 put parsed 0 1
 end
 end
 end
