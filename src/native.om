put s2 17 get tke ni
put st 2 0
put s2 5 0
put s2 9 0
k = add ni 1
while eq tkis k 0 2 0
k = pparam2 k nt
if ge k nt
trap 10
end
end
if ne add k 2 nt
trap 10
end
if gt get s2 5 6
trap 10
end
r = add k 1
put s2 8 1
put s2 18 3
if eq tkis r 15 4 1
put s2 18 7
else
if eq tkis r 24 4 1
put s2 8 0
put s2 18 9
else
if eq tkis r 10 5 0
trap 10
end
end
end
