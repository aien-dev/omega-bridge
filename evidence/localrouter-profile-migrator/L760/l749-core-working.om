 e = arrend i lim
 if eq e 0
 ret 0
 end
 ret add e 1
 end
 if eq b 123
 ret objend i lim
 end
 while lt i lim
 b = get source i
 if or or eq b 44 eq b 93 eq b 125
 ret i
 end
 i = add i 1
 end
 ret i
end

