#!/bin/sh
# tools/native: one Omega library and its declarations for six languages, from Omega function units.
# Usage: OMEGA_NATIVE_OMC=<seeded omc> tools/native [--target aarch64linux|x86linux] [--freestanding] OUTDIR unit.om [unit.om...]
# Each unit is one .om file in the native call subset (docs/NATIVE-ABI.md). An OM-1 unit (ABI v1): its
# last function is bound as omega_<name>, earlier ones are private helpers. An OM-2 unit (its first
# line that is not a note is exactly om2; ABI v2): each `export fn` (or, with none, its last function)
# is bound as omega2_<name>, and the unit carries its identity, read through omega2_ident_<unit>(),
# <unit> being the file's basename with every byte outside [A-Za-z0-9_] turned into _. OM-1 units are
# compiled by OMEGA_NATIVE_OMC (pinned below), OM-2 units by OMEGA_NATIVE_OMC2, whose sha256 is the omc
# digest embedded in their identity. For --target x86linux, OMEGA_NATIVE_X86_OMC (also pinned below)
# compiles both profiles; OMEGA_NATIVE_OMC still builds the generator. OUTDIR receives
#   omega_native.c     the library source: every unit's compiled code, embedded unchanged, behind
#                      uint32_t omega_<name>(uint64_t *result, ...) or omega2_<name>(...)
#   omega_native.h     its C and C++ declarations
#   omega_native.py    ctypes bindings (import it from beside libomega_native.so)
#   omega_native.rs    a Rust module (mod omega_native;), Rust 1.82 or later
#   omega_native.zig   a Zig 0.13 file (@import("omega_native.zig"))
#   omega_native.go    a cgo package omeganative: a folder of that name holding it, omega_native.h
#                      and the library
#   omega_api.h        only with an OM-2 unit: its layouts as C structs and its exports as static
#                      inline C functions that abort() on a nonzero status (includes omega_native.h)
#   omega_api_decl.h   only with an OM-2 unit: the same layouts and the exports' prototypes only, so
#   omega_api_defs.c   an object that includes it references no C library function; their
#                      out-of-line definitions (the abort() calls) are in omega_api_defs.c
#   libomega_native.so the library, built with omega_native.h included, so a declaration that
#                      disagrees with its definition fails this build
#   work/              the generator (native-gen), each unit's code (<unit>.bin), the framed
#                      generator input (units.in) and every unit's identity (ident.txt, OM-1 units
#                      included); tests/native/run.sh reads them. Not an interface.
# Everything is produced in a scratch folder and installed together after the library compiles. A
# refusal (a unit outside the subset, or a name the binding cannot carry) names the unit, exits 110
# and installs nothing; a previous run's outputs are replaced only on success. Extra C flags:
# OMEGA_NATIVE_CFLAGS.
# --freestanding accepts only pure integer-scalar OM-1 units and installs omega_native.{c,h,o}
# plus work/. The object has no undefined symbols except the GPU_FS_LINK libc-string allowlist.
# Calls use the caller's stack; traps return status without TLS, heap or a hosted runtime.
# Freestanding x86 output is not supported and is refused before creating OUTDIR.
set -eu
PIN=734f0a39319fbfa930bcc62cb30dbf06d47d78e126372b74f5baf478e6126b61
X86_PIN=f7752bc5c800e85c2393a08153786d0a6bc4516c9cea955fe27624228d6d1409
ROOT=$(cd "$(dirname "$0")/.." && pwd)
OMC=${OMEGA_NATIVE_OMC:?set OMEGA_NATIVE_OMC to the seeded omc (omega seed/out/omc, sha256 $PIN)}
got=$(sha256sum < "$OMC" | cut -d' ' -f1)
[ "$got" = "$PIN" ] || { echo "tools/native: omc sha256 $got, pinned $PIN" >&2; exit 1; }
CMODE=c
TARGET=aarch64linux
while [ $# -gt 0 ]; do
  case "$1" in
    --freestanding) CMODE=freest; shift ;;
    --target)
      [ $# -ge 2 ] || { echo "tools/native: --target requires aarch64linux or x86linux" >&2; exit 2; }
      TARGET=$2; shift 2 ;;
    --) shift; break ;;
    --*) echo "tools/native: unknown option $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
case "$TARGET" in
  aarch64linux) ;;
  x86linux)
    [ "$CMODE" != freest ] || { echo "tools/native: --freestanding is supported only for aarch64linux; nothing installed" >&2; exit 110; }
    X86_OMC=${OMEGA_NATIVE_X86_OMC:?set OMEGA_NATIVE_X86_OMC to the pinned x86 Linux compiler (sha256 $X86_PIN)}
    got=$(sha256sum < "$X86_OMC" | cut -d' ' -f1)
    [ "$got" = "$X86_PIN" ] || { echo "tools/native: x86 omc sha256 $got, pinned $X86_PIN" >&2; exit 1; } ;;
  *) echo "tools/native: unknown target $TARGET (expected aarch64linux or x86linux)" >&2; exit 2 ;;
esac
[ $# -ge 2 ] || { echo "usage: OMEGA_NATIVE_OMC=<omc> tools/native [--target aarch64linux|x86linux] [--freestanding] OUTDIR unit.om [unit.om...]" >&2; exit 2; }
OUT=$1; shift
mkdir -p "$OUT"
OUT=$(cd "$OUT" && pwd)
W=$(mktemp -d "$OUT/.native-work.XXXXXX")
mkdir "$W/work"
trap 'rm -rf "$W"' EXIT
"$OMC" < "$ROOT/src/native.om" > "$W/work/native-gen"; chmod +x "$W/work/native-gen"
generate() {
  if [ "$TARGET" = x86linux ]; then
    "$W/work/native-gen" "$1" x86linux
  else
    "$W/work/native-gen" "$1"
  fi
}
# The generator's input: each unit's source, a 0 byte, the code length in 8 decimal digits, the code;
# for an OM-2 unit then the line `omega-unit <unit> <sha256 of its selected compiler>`.
# Each unit is tried alone first, so a refusal names the unit.
: > "$W/work/units.in"; : > "$W/work/ident.txt"
v2=0
for u in "$@"; do
  b=$(basename "$u" .om)
  # One snapshot supplies profile, compilation, framing and identity even if the
  # caller replaces the original file while its compiler is running.
  cp -- "$u" "$W/work/$b.om"
  src=$W/work/$b.om
  # The profile: the first line that is not a note (the generator applies the same rule).
  if [ "$(sed -n '/^ *note\( \|$\)/d; p; q' "$src")" = om2 ]; then
    abi=2; prof=OM-2; v2=1
  else
    abi=1; prof=OM-1
  fi
  if [ "$TARGET" = x86linux ]; then
    pin=$X86_PIN
    # Only compiler input gets the directive. Framing and identity retain the
    # original snapshot, including its OM-2 profile marker and exact source hash.
    { printf 'target x86linux\n'; cat "$src"; } > "$W/work/$b.compile.om"
    "$X86_OMC" < "$W/work/$b.compile.om" > "$W/work/$b.bin"
  elif [ $abi = 2 ]; then
    OMC2=${OMEGA_NATIVE_OMC2:?tools/native: $u is an OM-2 unit; set OMEGA_NATIVE_OMC2 to the OM-2 compiler}
    pin=$(sha256sum < "$OMC2" | cut -d' ' -f1)
    "$OMC2" < "$src" > "$W/work/$b.bin"
  else
    pin=$PIN
    "$OMC" < "$src" > "$W/work/$b.bin"
  fi
  name=$(printf '%s' "$b" | tr -c 'A-Za-z0-9_' '_')
  { cat "$src"; printf '\0'; printf '%08d' "$(wc -c < "$W/work/$b.bin")"; cat "$W/work/$b.bin"
    [ $abi = 1 ] || printf 'omega-unit %s %s\n' "$name" "$pin"; } > "$W/one.in"
  if ! generate "$CMODE" < "$W/one.in" > /dev/null 2>&1; then
    echo "tools/native: refused $u: outside the native call subset, or a name the binding cannot carry (docs/NATIVE-ABI.md); nothing installed" >&2
    exit 110
  fi
  cat "$W/one.in" >> "$W/work/units.in"
  echo "omega-ident 1 unit=$name abi=$abi profile=$prof src=$(sha256sum < "$src" | cut -d' ' -f1) omc=$pin path=$u" >> "$W/work/ident.txt"
done
words="c h python rust zig go"; [ $v2 = 0 ] || words="$words api apih apic"
[ "$CMODE" != freest ] || words="freest h"
for w in $words; do
  if ! generate "$w" < "$W/work/units.in" > "$W/$w.out" 2> /dev/null; then
    echo "tools/native: refused the set of units (a bound or unit name repeats); nothing installed" >&2
    exit 110
  fi
done
mv "$W/$CMODE.out" "$W/omega_native.c"; mv "$W/h.out" "$W/omega_native.h"
if [ "$CMODE" = c ]; then
  mv "$W/python.out" "$W/omega_native.py"; mv "$W/rust.out" "$W/omega_native.rs"
  mv "$W/zig.out" "$W/omega_native.zig"; mv "$W/go.out" "$W/omega_native.go"
fi
[ $v2 = 0 ] || { mv "$W/api.out" "$W/omega_api.h"; mv "$W/apih.out" "$W/omega_api_decl.h"; mv "$W/apic.out" "$W/omega_api_defs.c"; }
# The library names itself (soname), so every caller records libomega_native.so and finds it via rpath.
if [ "$CMODE" = freest ]; then
  ${CC:-cc} -std=gnu11 -O2 -Wall -Wextra -Werror -Wmissing-prototypes -ffreestanding -fno-builtin \
    -include "$W/omega_native.h" ${OMEGA_NATIVE_CFLAGS:-} -c -o "$W/omega_native.o" "$W/omega_native.c"
  if ! nm -u "$W/omega_native.o" > "$W/undefined.txt"; then
    echo "tools/native: freestanding symbol inspection failed; nothing installed" >&2
    exit 1
  fi
  if ! awk 'NF && $NF !~ /^(_GLOBAL_OFFSET_TABLE_|memcpy|memmove|memset|memcmp|strlen|strcmp)$/ {print $NF; bad=1} END {exit bad}' \
    "$W/undefined.txt" > "$W/refused-imports.txt"; then
    echo "tools/native: freestanding imports refused by inspection; nothing installed" >&2
    cat "$W/refused-imports.txt" >&2
    exit 1
  fi
else
${CC:-cc} -std=gnu11 -O2 -Wall -Wextra -Werror -fPIC -shared -Wl,-soname,libomega_native.so \
  -include "$W/omega_native.h" ${OMEGA_NATIVE_CFLAGS:-} -o "$W/libomega_native.so" "$W/omega_native.c"
fi
# The API headers must compile on their own: their layout size and offset checks are C static
# assertions. The definitions are compiled against their prototypes (a disagreement fails here).
if [ $v2 = 1 ]; then
  ${CC:-cc} -std=gnu11 -fsyntax-only -Wall -Wextra -Werror -I "$W" -x c "$W/omega_api.h"
  ${CC:-cc} -std=gnu11 -fsyntax-only -Wall -Wextra -Werror -I "$W" -x c "$W/omega_api_decl.h"
  ${CC:-cc} -std=gnu11 -fsyntax-only -Wall -Wextra -Werror -Wmissing-prototypes -I "$W" "$W/omega_api_defs.c"
fi
# Install together: the previous run's outputs go, the new set comes in.
for f in omega_native.c omega_native.h omega_native.o omega_native.py omega_native.rs omega_native.zig omega_native.go omega_api.h omega_api_decl.h omega_api_defs.c libomega_native.so work; do
  rm -rf "$OUT/$f"; [ ! -e "$W/$f" ] || mv "$W/$f" "$OUT/$f"
done
if [ "$CMODE" = freest ]; then
  echo "tools/native: $# pure scalar unit(s) -> $OUT/omega_native.{c,h,o} (+ work/)"
else
  echo "tools/native: $# unit(s) -> $OUT/libomega_native.so + omega_native.{c,h,py,rs,zig,go}$([ $v2 = 0 ] || echo ' + omega_api.h, omega_api_decl.h, omega_api_defs.c') (+ work/)"
fi
