put lys n get tks 1
put lye n get tke 1
put lcs n get tks 1
put lce n get tke 1
put lyz n z
put lyl n i
put s2 10 add n 1
end
i = add e 1
end
i = p
while lt i q
e = lend i q
if eq isbrn i q 1
