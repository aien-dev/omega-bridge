note Route fixture with shared experts across rows and deliberately different picks.
for i ulong 64
put routes i uint rem add mul rem i 8 31 div i 8 256
end
if ne group 8 0
ret 20
end
for out ulong 64
j = ulong get mapping out
if ge j 64
ret 21
end
for p ulong out
if eq get mapping p uint j
ret 22
end
end
note Independent rank count including ties to original row/rank.
rank = ulong 0
for p ulong 64
a = get routes p
b = get routes j
if or lt a b and eq a b lt p j
rank = add rank 1
end
end
if ne rank out
ret 23
end
end
note Duplicate within a row is invalid; duplicate across rows is intentional.
put routes 1 get routes 0
if ne group 8 65
ret 24
end
put routes 1 uint 256
if ne group 8 65
ret 25
end
if ne group 0 65
ret 26
end
