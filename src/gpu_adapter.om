note Omega Bridge GPU adapter, protocol omega-bridge-gpu-adapter/1.
note Pure boundary: no device, no driver, no encoder, no launch. It decides
note whether a declared consumer may attach to a declared adapter, and it
note refuses every request it cannot prove from the fields below. A refusal
note never falls back to CPU or to another backend.
note Handwritten native Omega (seed omc); SHA-256 adapted from the Apache-2.0 WITH LLVM-exception
note Omega implementation in benchmarks-mv/build/base/om-sha256.om.

global src uchar 32768
global slen ulong 1
global lstart ulong 64
global llen ulong 64
global nlines ulong 1
global koff ulong 1
global klen ulong 1
global voff ulong 1
global vlen ulong 1
global coff ulong 1
global code ulong 1
global mode ulong 1
global adap ulong 1
global cons ulong 1
global pp ulong 1
global bad ulong 1
global wr ulong 1

note ---- protocol dictionaries ----
text keys "mode\nadapter\nconsumer\nbackend\nisa\ndriver\nabi\ndtypes\ncapabilities\nrights\nsync\ntelemetry\ncontract_id\nartifact_id\nkernel_format\nqmd_template\nreceipt\nownership\nalias\n"
global ko ulong 19
global kl ulong 19
text vals "omega-bridge-gpu-adapter/1\nnegotiate\nadmit\nfake-gpu\ngb10-native-cubin\nomega\nmax\nnvidia\nfake\nsm_121\nfake-1\nomega-gpu-platform/1.2\nbf16,f32\ncubin-load,launch-template,memory-handoff\nread,execute\nexplicit\noff\n580.173.02\nnvidia-cubin-elf64\nzero-va-v1\nvalid\nstale\nmissing\nproducer\nconsumer\nnone\nalias\n"
global vo ulong 27
global vl ulong 27
text codes "E_VERSION\nE_ORDER\nE_MODE\nE_ADAPTER\nE_BACKEND\nE_ISA\nE_DRIVER\nE_ABI\nE_DTYPES\nE_CAPABILITY\nE_RIGHTS\nE_SYNC\nE_TELEMETRY\nE_CONTRACT\nE_ARTIFACT\nE_FORMAT\nE_RELOC\nE_RECEIPT\nE_OWNERSHIP\nE_ALIAS\nE_LIMIT\nE_IO\n"
global co ulong 22
global cl ulong 22

text lver "verdict="
text lcode "code="
text lada "adapter="
text lcon "consumer="
text lisa "isa="
text lcid "contract_id="
text lsha "request_sha256="
text lacc "ACCEPT"
text lref "REFUSE"
text lf "\n"

note ---- SHA-256 state (AGPL, adapted) ----
global hk uint 64
global hs uint 8
global hm uint 64
global hb uchar 64
global hd uchar 64
global hmeta ulong 3
text hconst ""
text hseed "6a09e667bb67ae853c6ef372a54ff53a510e527f9b05688c1f83d9ab5be0cd19"
text hhex "0123456789abcdef"

fn hnib c uchar to uint
if le c 57
ret uint sub c 48
end
ret uint sub c 87
end

fn hreset to void
for i ulong 64
v = uint 0
for j ulong 8
v = or shl v 4 hnib get hconst add mul i 8 j
end
put hk i v
end
for i ulong 8
v = uint 0
for j ulong 8
v = or shl v 4 hnib get hseed add mul i 8 j
end
put hs i v
end
for i ulong 3
put hmeta i 0
end
end

fn hrot x uint n uint to uint
ret or shr x n shl x sub 32 n
end

fn hsmall0 x uint to uint
ret xor xor hrot x 7 hrot x 18 shr x 3
end

fn hsmall1 x uint to uint
ret xor xor hrot x 17 hrot x 19 shr x 10
end

fn hbig0 x uint to uint
ret xor xor hrot x 2 hrot x 13 hrot x 22
end

fn hbig1 x uint to uint
ret xor xor hrot x 6 hrot x 11 hrot x 25
end

fn hblock to void
for i ulong 16
v = uint 0
for j ulong 4
v = or shl v 8 uint get hb add mul i 4 j
end
put hm i v
end
for j ulong 48
i = add j 16
v = add hsmall1 get hm sub i 2 get hm sub i 7
v = add v hsmall0 get hm sub i 15
put hm i add v get hm sub i 16
end
a = get hs 0
b = get hs 1
c = get hs 2
d = get hs 3
e = get hs 4
f = get hs 5
g = get hs 6
h = get hs 7
for i ulong 64
t1 = add h hbig1 e
t1 = add t1 xor and e f and not e g
t1 = add t1 get hk i
t1 = add t1 get hm i
t2 = hbig0 a
t2 = add t2 xor xor and a b and a c and b c
h = g
g = f
f = e
e = add d t1
d = c
c = b
b = a
a = add t1 t2
end
put hs 0 add get hs 0 a
put hs 1 add get hs 1 b
put hs 2 add get hs 2 c
put hs 3 add get hs 3 d
put hs 4 add get hs 4 e
put hs 5 add get hs 5 f
put hs 6 add get hs 6 g
put hs 7 add get hs 7 h
end

fn hraw c uchar to void
n = get hmeta 0
put hb n c
n = add n 1
if eq n 64
hblock
n = ulong 0
end
put hmeta 0 n
end

fn hpush c uchar to bool
if ne get hmeta 2 0
ret false
end
if eq get hmeta 1 2305843009213693951
put hmeta 2 2
ret false
end
hraw c
put hmeta 1 add get hmeta 1 1
ret true
end

fn hfinal to bool
if ne get hmeta 2 0
ret false
end
bits = mul get hmeta 1 8
hraw 128
while ne get hmeta 0 56
hraw 0
end
for i ulong 8
shift = mul sub 7 i 8
hraw uchar and shr bits shift 255
end
for i ulong 8
v = get hs i
for j ulong 8
shift = uint mul sub 7 j 4
digit = ulong and shr v shift 15
put hd add mul i 8 j get hhex digit
end
end
put hmeta 2 1
ret true
end

