fn tokval to ulong
if eq get tk 0 2
ret get tw 0
end
c = constof
if eq c 99
fail 16
end
if ne get co_ty c 5
fail 16
end
ret get co_val c
end

fn parsecon to void
tok
if ne get tk 0 1
fail 16
end
i = get nc 0
if ge i 32
fail 14
end
if ne constof 99
fail 10
end
put co_off i get ts 0
put co_nl i get tl 0
tok
t = ty_of get tw 0
if eq t 0
fail 7
end
tok
if ne get tk 0 2
fail 24
end
negative = ulong 0
if eq get src get ts 0 45
negative = 1
end
n = node 1 0 0 negative get tw 0
checknum n t
put co_ty i t
put co_val i get nv n
put co_neg i get nb n
put nc 0 add i 1
end


fn add_loc o ulong n ulong ty ulong k ulong ln ulong par ulong to void
i = get nloc 0
if ge i 32
fail 14
end
put loc_off i o
put loc_nl i n
put loc_ty i ty
put loc_k i k
put loc_len i ln
put loc_par i par
