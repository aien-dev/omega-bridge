ret unit2 p q
end
fl = sigln p q
parse fl q
cl = codelen q
c0 = add q 9
emit c0 cl
ret add c0 cl
end
note slurp: all of stdin into inb; refuse input that fills the pool.
fn slurp to ulong
t = ulong 0
k = read 0 inb 0 len inb
while gt k 0
t = add t ulong k
k = long 0
if lt t len inb
k = read 0 inb t sub len inb t
end
end
if lt k 0
trap 11
end
if ge t len inb
trap 6
end
ret t
end
