 fn ws i ulong to ulong
 b = get source i
 if or eq b 32 eq b 9
 ret 1
 end
 if or eq b 10 eq b 13
 ret 1
 end
 ret 0
 end


 fn skipws pos ulong lim ulong to ulong
 i = pos
 while lt i lim
 if eq ws i 0
 ret i
 end
 i = add i 1
 end
 ret i
 end

 fn strend start ulong lim ulong to ulong
 i = add start 1
 esc = ulong 0
 while lt i lim
 b = get source i
 if eq esc 1
 esc = 0
 else
 if eq b 92
 esc = 1
 else
 if eq b 34
 ret i
 end
 if lt b 32
 ret 0
 end
 end
 end
 i = add i 1
 end
 ret 0
 end

 fn arrend start ulong lim ulong to ulong
 i = start
 depth = ulong 0
 quote = ulong 0
 esc = ulong 0
 while lt i lim
 b = get source i
 if eq quote 1
 if eq esc 1
 esc = 0
 else
 if eq b 92
 esc = 1
 else
 if eq b 34
 quote = 0
 end
 end
 end
 else
 if eq b 34
 quote = 1
 else
 if eq b 91
 depth = add depth 1
 else
 if eq b 93
 depth = sub depth 1
 if eq depth 0
 ret i
 end
 end
 end
 end
 end
 i = add i 1
 end
 ret 0
 end

 fn valid_repl to ulong
 n = get rlen 0
 if or lt n 3 gt n 256
 ret 0
 end
 if ne get repl 0 91
 ret 0
 end
 i = ulong 1
 count = ulong 0
 while lt i n
 if ne get repl i 34
 ret 0
 end
 i = add i 1
 esc = ulong 0
 closed = ulong 0
 while and lt i n eq closed 0
 b = get repl i
 if eq esc 1
 esc = 0
 else
 if eq b 92
 esc = 1
 else
 if eq b 34
 closed = 1
 else
 if lt b 32
 ret 0
 end
 end
 end
 end
 i = add i 1
 end
 if eq closed 0
 ret 0
 end
 count = add count 1
 if eq i n
 ret 0
 end
 if eq get repl i 44
 i = add i 1
 else
 if eq get repl i 93
 i = add i 1
 if and eq i n gt count 0
 ret 1
 end
 ret 0
 else
 ret 0
 end
 end
 end
 ret 0
 end

