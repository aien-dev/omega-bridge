note entry.om: test plumbing for tests/native/v2 (not part of the bridge). Builds the code of a
note multi-entry unit in the layout the OM-2 compiler agreed for `export fn` (omega-mv S4, ledger L834):
note words 0 .. E-1 are `b <entry k>`, then the entries' code. Input on stdin: E pieces, each its code
note length in 8 decimal digits then its code, a function-mode unit whose entry is its word 0. Output on
note stdout: the E branch words (little endian) and the pieces, unchanged, in order.
global inb uchar 4194304
global outb uchar 4194304
global ps ulong 32
global pl ulong 32
global st ulong 2
fn ob b uchar to void
n = get st 1
if ge n len outb
trap 6
end
put outb n b
put st 1 add n 1
end
fn slurp to ulong
t = ulong 0
k = read 0 inb 0 len inb
while gt k 0
t = add t ulong k
k = long 0
if lt t len inb
k = read 0 inb t sub len inb t
end
end
if lt k 0
trap 11
end
if ge t len inb
trap 6
end
ret t
end
note piece: the 8-digit length at p; records the piece in slot n; returns where the next one starts.
fn piece p ulong t ulong n ulong to ulong
if gt add p 8 t
trap 10
end
v = ulong 0
for j ulong 8
d = get inb add p j
if or lt d 48 gt d 57
trap 10
end
v = add mul v 10 ulong sub d 48
end
if or eq v 0 ne rem v 4 0
trap 10
end
if gt v sub t add p 8
trap 10
end
put ps n add p 8
put pl n v
ret add add p 8 v
end
fn main to int
t = slurp
put st 1 0
p = ulong 0
n = ulong 0
while lt p t
if ge n 32
trap 10
end
p = piece p t n
n = add n 1
end
if eq n 0
trap 10
end
at = mul n 4
for k ulong n
w = or 335544320 and div sub at mul k 4 4 67108863
for j ulong 4
ob uchar and shr w mul j 8 255
end
at = add at get pl k
end
for k ulong n
s = get ps k
for j ulong get pl k
ob get inb add s j
end
end
o = ulong 0
m = get st 1
while lt o m
w = write 1 outb o sub m o
if le w 0
ret 1
end
o = add o ulong w
end
ret 0
end
