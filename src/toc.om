i = add i 1
end
ret 4096
end
fn kwconst to ulong
if or eq get seeded 0 0 ne get tl 0 len cword
ret 0
end
for i ulong len cword
if ne get src add get ts 0 i get cword i
ret 0
end
end
ret 1
end

fn constof to ulong
i = ulong 0
while lt i get nc 0
if eq same_name get co_off i get co_nl i 1
ret i
end
i = add i 1
end
ret 99
