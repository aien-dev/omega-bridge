fn viewqual k ulong to void
if and eq get seeded 0 1 eq k 2
for i ulong len qual
e_b ulong get qual i
end
end
end

fn mputb b uchar to void
m = get mc 0
put msg m b
put mc 0 add m 1
end

fn mputn v ulong to void
d = new uchar 20 0
i = ulong 0
x = v
put d 0 uchar add rem x 10 48
x = div x 10
i = add i 1
while gt x 0
put d i uchar add rem x 10 48
x = div x 10
i = add i 1
end
j = i
while gt j 0
j = sub j 1
mputb get d j
end
end

fn fail code ulong to void
put mc 0 0
mputb 116
mputb 111
mputb 99
mputb 58
mputb 32
mputb 108
mputb 105
mputb 110
mputb 101
mputb 32
