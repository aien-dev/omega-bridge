 if ne get target 0 0
 ret 7
 end
 put target 0 1
 if lt vpos lim
 if eq get source vpos 123
 put fpos 0 vpos
 put finish 0 vend
 end
 end
 end
 i = skipws vend lim
 if lt i lim
 if eq get source i 44
 i = add i 1
 else
 if ne get source i 125
 ret 3
 end
 end
 end
 end
 end
 if eq get parsed 0 1
 put elen 0 add get elen 0 1
 if or ne get target 0 1 eq get fpos 0 0
 ret 5
 end
 rc = options_server get fpos 0 get finish 0
 if ne rc 0
 ret rc
 end
 put nfound 0 add get nfound 0 1
 end
 ret 0
end

fn root_tools n ulong to int
 ret 0
end

fn locate n ulong to int
 rc = root_tools n
 if ne rc 0
 ret rc
 end
 put nfound 0 0
 put elen 0 0
 i = skipws add get fpos 0 1 get fsize 0
 while lt i get fsize 0
 vend = valueend i get fsize 0
 if eq vend 0
 ret 3
 end
 if eq get source i 123
 rc = inspect_tool i vend
 if ne rc 0
 ret rc
 end
 end
 i = skipws vend get fsize 0
 if lt i get fsize 0
 if eq get source i 44
 i = add i 1
 else
 if ne get source i 93
 ret 3
 end
 end
 end
 end
 if or ne get elen 0 1 ne get nfound 0 1
 ret 5
 end
 ret 0
end

 fn compose n ulong rn ulong to int
 start = get target 0
 stop = get finish 0
 newlen = add start rn
 tail = sub n stop
 newlen = add newlen tail
 if gt newlen len outbuf
 ret 6
 end
 k = ulong 0
 while lt k start
 put outbuf k get source k
 k = add k 1
 end
 j = ulong 0
 while lt j rn
 dest = add start j
 put outbuf dest get repl j
 j = add j 1
 end
 k = stop
 dest = add start rn
 while lt k n
 put outbuf dest get source k
 k = add k 1
 dest = add dest 1
 end
 put olen 0 newlen
 ret 0
 end

 fn migrate to int
 n = get slen 0
 rn = get rlen 0
 if or or eq n 0 gt n 4096 lt rn 3
 ret 1
 end
 if eq valid_repl 0
 ret 2
 end
 rc = locate n
 if ne rc 0
 ret rc
 end
 ret compose n rn
 end

 fn header to ulong
 value = ulong 0
 digit = ulong 0
 while lt get fpos 0 get fsize 0
 b = ulong get expect get fpos 0
 if eq b 10
 put parsed 0 value
 put fpos 0 add get fpos 0 1
 ret 1
 end
 if or lt b 48 gt b 57
 ret 0
 end
 digit = sub b 48
 value = mul value 10
 value = add value digit
 if gt value 8192
 ret 0
 end
 put fpos 0 add get fpos 0 1
 end
 ret 0
 end
