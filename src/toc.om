fn add_loc o ulong n ulong ty ulong k ulong ln ulong par ulong to void
i = get nloc 0
if ge i 32
fail 14
end
put loc_off i o
put loc_nl i n
put loc_ty i ty
put loc_k i k
put loc_len i ln
put loc_par i par
put nloc 0 add i 1
end

fn walk_sig rec ulong to void
tok
if ne get tk 0 1
fail 16
end
if gt get tl 0 8
fail 13
end
ix = get nf 0
if eq rec 1
if ne fn_of 99
fail 10
end
if ge ix 32
fail 14
end
put fn_name ix get tw 0
put fn_off ix get ts 0
put fn_nl ix get tl 0
put fn_np ix 0
if eq get tw 0 1852399981
put hasmain 0 1
end
put cfi 0 ix
else
put cfi 0 fn_of
if eq get cfi 0 99
fail 3
end
end
tok
while eq isw 28532 0
if ne get tk 0 1
fail 16
end
po = get ts 0
pn = get tl 0
tok
pk = ulong 0
pty = ulong 0
pln = ulong 0
if eq isw 2003134838 1
pk = 2
end
if eq isw 1953064037 1
pk = 3
end
if gt pk 0
tok
pty = ty_of get tw 0
if eq pty 0
fail 7
end
tok
if ne get tk 0 2
fail 16
end
pln = get tw 0
else
pty = ty_of get tw 0
if eq pty 0
fail 7
end
end
if eq rec 1
if ge get fn_np ix 4
fail 24
end
slot = add mul ix 4 get fn_np ix
put fn_pt slot pty
put fn_pl slot pln
put fn_pk slot pk
put fn_poff slot po
put fn_pnl slot pn
put fn_np ix add get fn_np ix 1
end
tok
end
tok
rt = ulong 10
if eq isw 1684631414 0
rt = ty_of get tw 0
if eq rt 0
fail 7
end
end
if eq rec 1
put fn_ret ix rt
put nf 0 add ix 1
end
end

fn parse_global to void
tok
if ne get tk 0 1
fail 16
end
i = get ng 0
if ge i 8
fail 14
end
put g_off i get ts 0
put g_nl i get tl 0
tok
ty = ty_of get tw 0
if eq ty 0
fail 7
end
put g_ty i ty
put g_ro i 0
tok
if ne get tk 0 2
fail 16
end
if or eq get tw 0 0 gt get tw 0 524288
fail 23
end
put g_len i get tw 0
put ng 0 add i 1
end

note Text shares the bounded global table; its bytes and length are independent.
fn parse_tx to void
tok
if ne get tk 0 1
fail 16
end
i = get ng 0
if ge i 8
fail 14
end
put g_off i get ts 0
put g_nl i get tl 0
put g_ty i 2
put g_ro i 1
put g_pos i get textuse 0
tok
if ne get tk 0 4
fail 16
end
p = get tw 0
e = add p get tl 0
while lt p e
b = get src p
p = add p 1
if eq b 92
b = get src p
p = add p 1
if eq b 110
b = uchar 10
else
if eq b 116
b = uchar 9
else
if and ne b 92 ne b 34
fail 22
