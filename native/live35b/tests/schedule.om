note Actual full128-token prefill grouping,256 expert segments,shared row and padding.
for i ulong 1024
put routes i uint rem i 256
end
if ne group 128 0
ret 41
end
if ne get segnum 0 256
ret 42
end
for e ulong 256
if ne get segments mul e 3 uint e
