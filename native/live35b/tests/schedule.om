end
if ne get segments add mul e 3 1 uint mul e 4
ret 44
end
if ne get segments add mul e 3 2 uint 4
ret 45
end
end
for p ulong 1024
j = add div p 4 mul rem p 4 256
if ne get mapping p uint j
ret 46
end
if ne get xmap p uint div j 8
ret 47
end
if ne get ymap p uint add mul div j 8 9 rem j 8
ret 48
end
end
for t ulong 128
if ne get sxmap t uint t
ret 49
end
if ne get symap t uint add mul t 9 8
ret 50
end
end
for p ulong 8
if or ne get xmap add 1024 p 0 ne get ymap add 1024 p 0
ret 51
end
if or ne get sxmap add 128 p 0 ne get symap add 128 p 0
ret 52
end
end
note Prefix/tool marks, final logit boundary, long context and exact endpoints.
