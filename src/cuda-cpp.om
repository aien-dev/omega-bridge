end
fn tempref n ulong to void
for j ulong len C4
emitb get C4 j
end
number n
end
fn expression n ulong to void
k = get Op n
if lt k 3
leaf k get Val n
else
opword k
tempref get Left n
emitb 32
tempref get Right n
end
end
fn phase to void
for j ulong get Size 0
c = get Src j
if or eq c 0 eq c 92
die 65
end
if and eq c 63 lt add j 2 get Size 0
if eq get Src add j 1 63
die 65
end
end
end
end
fn cpu root ulong to void
emit 0
for j ulong get Nodes 0
for k ulong len C5
emitb get C5 k
end
number j
emitb 32
expression j
emitb 10
end
for j ulong len C6
emitb get C6 j
end
number root
emit 1
for j ulong add get Count 0 1
emit 2
number j
emit 3
end
emit 4
for j ulong len Pack
emitb get Pack j
end
end
fn main to int
r = read 0 Mode 0 1
if ne r 1
die 77
end
if not or eq get Mode 0 67 eq get Mode 0 71
die 65
end
n = ulong 0
go = true
while and go lt n len Src
r = read 0 Src n sub len Src n
if lt r 0
die 77
end
if eq r 0
go = false
else
n = add n ulong r
end
end
if eq n len Src
r = read 0 Extra 0 1
if lt r 0
die 77
end
if gt r 0
die 67
end
end
put Size 0 n
phase
next
signature
index
root = expr 1
symbol 59
symbol 125
symbol 125
if ne get Kind 0 0
die 65
