#!/bin/sh
# standin-omc: the stand-in for the OM-2 compiler that tests/native/v2/run.sh uses until omega-mv S4
# (ledger L834, branch om2/compiler-s4) exists. It is NOT an OM-2 compiler. It recognizes the test units
# of this folder by their exact bytes and writes code built from their OM-1 stand-ins
# (standin/<unit>.<k>.om is entry k), each compiled by the pinned seeded omc (OMEGA_NATIVE_OMC), under
# the calling convention agreed with S4: parameters in x0..x5 in order, an unsized view as its pointer
# then its element count, a layout or an out parameter as one pointer; with exports, words 0..E-1 branch
# to the entries in source order (entry.om). Any other input is refused (exit 1). Its sha256 is what the
# bindings built with it carry as their omc digest, so no such binding can pass for S4's.
set -eu
D=$(cd "$(dirname "$0")" && pwd)
OMC=${OMEGA_NATIVE_OMC:?standin-omc: set OMEGA_NATIVE_OMC to the seeded omc}
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
cat > "$T/in.om"
b=
for u in "$D"/*.om; do
  if [ "$(basename "$u")" != entry.om ] && cmp -s "$u" "$T/in.om"; then b=$(basename "$u" .om); break; fi
done
[ -n "$b" ] || { echo "standin-omc: not one of the tests/native/v2 units" >&2; exit 1; }
n=$(grep -c '^export fn ' "$T/in.om" || true)
k=0; : > "$T/pieces"
while [ -f "$D/standin/$b.$k.om" ]; do
  "$OMC" < "$D/standin/$b.$k.om" > "$T/p.bin"
  printf '%08d' "$(wc -c < "$T/p.bin")" >> "$T/pieces"; cat "$T/p.bin" >> "$T/pieces"
  k=$((k + 1))
done
if [ "$n" = 0 ]; then
  [ "$k" = 1 ] || { echo "standin-omc: $b needs exactly one stand-in" >&2; exit 1; }
  cat "$T/p.bin"
else
  [ "$k" = "$n" ] || { echo "standin-omc: $b has $n exports and $k stand-ins" >&2; exit 1; }
  "$OMC" < "$D/entry.om" > "$T/entry"; chmod +x "$T/entry"
  "$T/entry" < "$T/pieces"
fi
